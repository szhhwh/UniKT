#: ../../source/developer-guides/customize-callback.md:110
#: d27ba498e6fa4b11b5c9e558a6bff22a
msgid "案例 1：周期性动态特征聚类与字典更新"
msgstr "Case 1: Periodic Dynamic Feature Clustering and Dictionary Updates"

#: ../../source/developer-guides/customize-callback.md:112
#: 4ee23f9f397345d58ba99ea97ba7fb5c
msgid "在 TCKT 模型中，每轮训练前需要用上一轮学到的模型交互嵌入在训练集上进行 Mini-Batch K-Means 聚类，动态更新一个全局特征字典。"
msgstr ""
"In the TCKT model, prior to each training epoch, learned interaction "
"embeddings from the previous epoch are clustered using Mini-Batch K-Means"
" on the training set to dynamically update a global feature dictionary."

#: ../../source/developer-guides/customize-callback.md:114
#: 6cea4c484ffc42958dbe641c1875fab9
msgid ""
"from utils.training import BaseTrainer, Callback\n"
"\n"
"\n"
"class GlobalDictRefreshCallback(Callback):\n"
"    \"\"\"TCKT 全局字典周期性更新回调。\"\"\"\n"
"\n"
"    def __init__(self, trainer: \"TCKTTrainer\"):\n"
"        self.trainer = trainer\n"
"\n"
"    def on_epoch_begin(self, epoch: int, **kwargs):\n"
"        \"\"\"每个 epoch 开始时重新聚类并更新模型字典。\"\"\"\n"
"        self.trainer.refresh_global_dict()\n"
"\n"
"\n"
"class TCKTTrainer(BaseTrainer):\n"
"    def build_callbacks(self) -> list[Callback]:\n"
"        \"\"\"向框架注册 TCKT 特有的回调。\"\"\"\n"
"        return [GlobalDictRefreshCallback(self)]\n"
"\n"
"    @torch.inference_mode()\n"
"    def refresh_global_dict(self) -> None:\n"
"        \"\"\"聚类逻辑实现。\"\"\"\n"
"        self.model.eval()\n"
"        # 遍历训练集提取潜变量并执行 K-Means...\n"
"        # self.model.global_dict.data.copy_(...)\n"
msgstr ""
"from utils.training import BaseTrainer, Callback\n"
"\n"
"\n"
"class GlobalDictRefreshCallback(Callback):\n"
"    \"\"\"TCKT global dictionary periodic refresh callback.\"\"\"\n"
"\n"
"    def __init__(self, trainer: \"TCKTTrainer\"):\n"
"        self.trainer = trainer\n"
"\n"
"    def on_epoch_begin(self, epoch: int, **kwargs):\n"
"        \"\"\"Re-cluster and refresh the model dictionary at the start of"
" each epoch.\"\"\"\n"
"        self.trainer.refresh_global_dict()\n"
"\n"
"\n"
"class TCKTTrainer(BaseTrainer):\n"
"    def build_callbacks(self) -> list[Callback]:\n"
"        \"\"\"Register TCKT-specific callbacks with the framework.\"\"\"\n"
"        return [GlobalDictRefreshCallback(self)]\n"
"\n"
"    @torch.inference_mode()\n"
"    def refresh_global_dict(self) -> None:\n"
"        \"\"\"Clustering implementation logic.\"\"\"\n"
"        self.model.eval()\n"
"        # Iterate over the training set to extract latent variables and "
"perform K-Means...\n"
"        # self.model.global_dict.data.copy_(...)\n"

#: ../../source/developer-guides/customize-callback.md:142
#: d46fff4d1ba94efd947ce5570008fecb
msgid "案例 2：显存清理与温度调度回调"
msgstr "Case 2: Memory Cleanup and Temperature Scheduling Callback"

#: ../../source/developer-guides/customize-callback.md:144
#: 54a8c10b1b7849018e5c80789218b78a
msgid ""
"import torch\n"
"from utils.training import Callback\n"
"\n"
"\n"
"class AnnealingAndCleanupCallback(Callback):\n"
"    \"\"\"动态调整退火温度并在 Epoch 结束清理 CUDA 缓存。\"\"\"\n"
"\n"
"    def __init__(self, trainer, initial_temp: float = 1.0, decay: float ="
" 0.95):\n"
"        self.trainer = trainer\n"
"        self.temp = initial_temp\n"
"        self.decay = decay\n"
"\n"
"    def on_epoch_begin(self, epoch: int, **kwargs):\n"
"        self.temp *= self.decay\n"
"        # 更新模型中的温度参数\n"
"        if hasattr(self.trainer.model, \"temperature\"):\n"
"            self.trainer.model.temperature = self.temp\n"
"\n"
"    def on_epoch_end(\n"
"        self, epoch: int, train_loss: float, val_loss: float | None, "
"**kwargs\n"
"    ):\n"
"        # 显存清理\n"
"        if torch.cuda.is_available():\n"
"            torch.cuda.empty_cache()\n"
msgstr ""
"import torch\n"
"from utils.training import Callback\n"
"\n"
"\n"
"class AnnealingAndCleanupCallback(Callback):\n"
"    \"\"\"Dynamically adjust annealing temperature and clean CUDA cache "
"at epoch end.\"\"\"\n"
"\n"
"    def __init__(self, trainer, initial_temp: float = 1.0, decay: float ="
" 0.95):\n"
"        self.trainer = trainer\n"
"        self.temp = initial_temp\n"
"        self.decay = decay\n"
"\n"
"    def on_epoch_begin(self, epoch: int, **kwargs):\n"
"        self.temp *= self.decay\n"
"        # Update temperature parameter in model\n"
"        if hasattr(self.trainer.model, \"temperature\"):\n"
"            self.trainer.model.temperature = self.temp\n"
"\n"
"    def on_epoch_end(\n"
"        self, epoch: int, train_loss: float, val_loss: float | None, "
"**kwargs\n"
"    ):\n"
"        # Memory cleanup\n"
"        if torch.cuda.is_available():\n"
"            torch.cuda.empty_cache()\n"

#: ../../source/developer-guides/customize-callback.md:173
#: 7257b78e9d9f4db68996cfef2f26f72f
msgid "自定义损失函数机制"
msgstr "Custom Loss Function Mechanisms"

#: ../../source/developer-guides/customize-callback.md:175
#: e7ab64be7b664169b55955b04932d199
msgid "UniKT 在架构上清晰解耦了**训练损失**与**评估损失**。"
msgstr ""
"UniKT architecturally decouples **training loss** from **evaluation "
"loss**."

#: ../../source/developer-guides/customize-callback.md:177
#: e99130d67df247cca8e136bf59f9f11c
msgid "解耦设计规范"
msgstr "Decoupled Design Specification"

#: ../../source/developer-guides/customize-callback.md:179
#: c5fe848a99b04610a95ab24b78b7f867
msgid ""
"# BaseTrainer 中的默认实现\n"
"def _compute_loss(self, outputs: dict) -> torch.Tensor:\n"
"    \"\"\"仅在训练阶段调用，用于 loss.backward()。\"\"\"\n"
"    return self.loss(outputs[\"y_hat\"], outputs[\"y_label\"])\n"
"\n"
"\n"
"def _compute_eval_loss(self, outputs: dict) -> torch.Tensor:\n"
"    \"\"\"在验证与测试阶段调用，仅用于统计评估损失。\"\"\"\n"
"    return self.loss(outputs[\"y_hat\"], outputs[\"y_label\"])\n"
msgstr ""
"# Default implementation in BaseTrainer\n"
"def _compute_loss(self, outputs: dict) -> torch.Tensor:\n"
"    \"\"\"Called only during training for loss.backward().\"\"\"\n"
"    return self.loss(outputs[\"y_hat\"], outputs[\"y_label\"])\n"
"\n"
"\n"
"def _compute_eval_loss(self, outputs: dict) -> torch.Tensor:\n"
"    \"\"\"Called during validation and testing strictly to record "
"evaluation loss.\"\"\"\n"
"    return self.loss(outputs[\"y_hat\"], outputs[\"y_label\"])\n"

#: ../../source/developer-guides/customize-callback.md:191
#: 11f8d3595d2d4f14b6e2293b924271c1
msgid "**`_compute_loss`**：用于反向传播梯度。模型可以在此处加入**对比学习损失**、**图正则化损失**、**知识状态平滑项**或**多任务辅助损失**。"
msgstr ""
"**`_compute_loss`**: Used for gradient backpropagation. Models can "
"incorporate **contrastive learning losses**, **graph regularization "
"losses**, **knowledge state smoothness constraints**, or **multi-task "
"auxiliary losses** here."

#: ../../source/developer-guides/customize-callback.md:192
#: c3b866884bc340e090488f403be13fad
msgid ""
"**`_compute_eval_loss`**：默认只使用纯净的主预测损失（如标准二元交叉熵 BCELoss），确保在验证集和测试集上记录的 "
"`loss` 指标在不同模型间具备公平可比性，不被辅助项人为拉大。"
msgstr ""
"**`_compute_eval_loss`**: Defaults to using strictly the pure primary "
"prediction loss (e.g., standard binary cross-entropy BCELoss), ensuring "
"recorded validation and test set `loss` metrics remain fairly comparable "
"across models without distortion by auxiliary objectives."

#: ../../source/developer-guides/customize-callback.md:194
#: 7a6adf03a2b648d19b5ca6ee6633b30d
msgid "案例：接入对比学习辅助损失"
msgstr "Case: Integrating Contrastive Learning Auxiliary Loss"

#: ../../source/developer-guides/customize-callback.md:196
#: e0331481257a45d9befbcbb7033ea028
msgid "在 CL4KT 中，除了主答题预测损失外，还需要计算原序列与数据增强序列之间的对比损失："
msgstr ""
"In CL4KT, beyond the primary response prediction loss, a contrastive loss"
" between original and augmented sequences must be computed:"

#: ../../source/developer-guides/customize-callback.md:198
#: 038ae01faac34b4da8e1d8735e5e5b7b
#, python-brace-format
msgid ""
"class CL4KTTrainer(BaseTrainer):\n"
"    def forward_pass(self, batch_data: tuple) -> dict[str, torch.Tensor]:"
"\n"
"        # 1. 前向传播计算主任务预测与对比损失\n"
"        y_hat, cl_loss = self.model(batch_data)\n"
"\n"
"        y_hat_valid, y_label_valid, _ = self._extract_valid_predictions(\n"
"            y_hat, batch_data.response, batch_data.mask\n"
"        )\n"
"\n"
"        return {\n"
"            \"y_hat\": y_hat_valid,\n"
"            \"y_label\": y_label_valid,\n"
"            \"y_predict\": "
"self._generate_binary_predictions(y_hat_valid),\n"
"            \"cl_loss\": cl_loss,  # 将辅助损失放入输出字典中\n"
"        }\n"
"\n"
"    def _compute_loss(self, outputs: dict) -> torch.Tensor:\n"
"        \"\"\"重写训练损失计算：主 BCE 损失 + 对比损失加权。\"\"\"\n"
"        # 主任务二元交叉熵损失\n"
"        bce_loss = self.loss(outputs[\"y_hat\"], outputs[\"y_label\"])\n"
"\n"
"        # 从 RunConfig 读取对比损失超参数权重\n"
"        reg_weight = self.run_config.model.reg_cl\n"
"\n"
"        if \"cl_loss\" in outputs and reg_weight > 0:\n"
"            return bce_loss + reg_weight * outputs[\"cl_loss\"]\n"
"\n"
"        return bce_loss\n"
msgstr ""
"class CL4KTTrainer(BaseTrainer):\n"
"    def forward_pass(self, batch_data: tuple) -> dict[str, torch.Tensor]:"
"\n"
"        # 1. Forward pass computing primary prediction and contrastive "
"loss\n"
"        y_hat, cl_loss = self.model(batch_data)\n"
"\n"
"        y_hat_valid, y_label_valid, _ = self._extract_valid_predictions(\n"
"            y_hat, batch_data.response, batch_data.mask\n"
"        )\n"
"\n"
"        return {\n"
"            \"y_hat\": y_hat_valid,\n"
"            \"y_label\": y_label_valid,\n"
"            \"y_predict\": "
"self._generate_binary_predictions(y_hat_valid),\n"
"            \"cl_loss\": cl_loss,  # Store auxiliary loss in output dict\n"
"        }\n"
"\n"
"    def _compute_loss(self, outputs: dict) -> torch.Tensor:\n"
"        \"\"\"Override training loss: primary BCE loss + weighted "
"contrastive loss.\"\"\"\n"
"        # Primary binary cross-entropy loss\n"
"        bce_loss = self.loss(outputs[\"y_hat\"], outputs[\"y_label\"])\n"
"\n"
"        # Read contrastive loss weight from RunConfig\n"
"        reg_weight = self.run_config.model.reg_cl\n"
"\n"
"        if \"cl_loss\" in outputs and reg_weight > 0:\n"
"            return bce_loss + reg_weight * outputs[\"cl_loss\"]\n"
"\n"
"        return bce_loss\n"

