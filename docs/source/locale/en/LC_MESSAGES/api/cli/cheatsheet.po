"all defaults and overrides:"

#: ../../source/api/cli/cheatsheet.md:115 8d2edd4456824a38879f90e97b89a571
msgid ""
"python train.py -m DKT -d assistments09 --data.fold 1 --model.batch_size "
"64 --print_config\n"
msgstr ""
"python train.py -m DKT -d assistments09 --data.fold 1 --model.batch_size "
"64 --print_config\n"

#: ../../source/api/cli/cheatsheet.md:121 aa7b5750958c4968b28f1b37f7c3a0f0
msgid "配置文件支持 (`--config`)"
msgstr "Configuration File Support (`--config`)"

#: ../../source/api/cli/cheatsheet.md:123 326cfb54c7204906af1f2d24e53df46c
msgid "UniKT 支持通过 YAML 配置文件进行批量化配置管理："
msgstr ""
"UniKT supports batch configuration management via YAML configuration "
"files:"

#: ../../source/api/cli/cheatsheet.md:125 0c4a978033354ecdbfa670fbefe2ed4c
msgid "python train.py --config configs/my_experiment.yaml\n"
msgstr "python train.py --config configs/my_experiment.yaml\n"

#: ../../source/api/cli/cheatsheet.md:129 736c497824d741b7a4d0005a7e46e923
msgid "CLI 参数的优先级高于配置文件。例如：在载入 YAML 的同时临时修改学习率和设备："
msgstr ""
"CLI arguments take precedence over configuration files. For example, "
"temporarily modifying learning rate and device while loading a YAML file:"

#: ../../source/api/cli/cheatsheet.md:131 a93fb6593b174a708e62cd12a38cb78f
msgid ""
"python train.py --config configs/my_experiment.yaml --model.learning_rate"
" 0.0005 --general.device cuda:1\n"
msgstr ""
"python train.py --config configs/my_experiment.yaml --model.learning_rate"
" 0.0005 --general.device cuda:1\n"

#: ../../source/api/cli/cheatsheet.md:137 5e8fd7c59f0e4fe98c4b02abd9cc4f03
msgid "常用典型命令速查"
msgstr "Common Typical Command Cheatsheet"

#: ../../source/api/cli/cheatsheet.md:139 7b957659331e45508d5bea8865f4408f
msgid ""
"# 1. 基础 GPU 训练（指定 Fold 0）\n"
"python train.py -m DKT -d assistments09 --data.fold 0\n"
"\n"
"# 2. 指定显卡并调整批大小与学习率\n"
"python train.py -m AKT -d assistments09 --general.device cuda:1 "
"--model.batch_size 64 --model.learning_rate 1e-4\n"
"\n"
"# 3. 离线调试（无云端同步，关闭测试评估，采样 500 个学生）\n"
"python train.py -m DKT -d assistments09 --general.cloud_tracking false "
"--general.skip_test true --data.sample_size 500\n"
"\n"
"# 4. 修改早停策略（监控验证集 loss，容忍 15 个 epoch）\n"
"python train.py -m GIKT -d assistments09 --early_stopping.monitor loss "
"--early_stopping.mode min --early_stopping.patience 15\n"
"\n"
"# 5. 独立评估某个实验运行目录\n"
"python evaluate.py --evaluate.run_dir "
"runs/normal/DKT_assistments09_20261109-133000_fold0_bs128\n"
"\n"
"# 6. 使用 PyTorch Inductor 图编译加速训练\n"
"python train.py -m SimpleKT -d assistments09 --compile.compile true "
"--compile.compile_mode default\n"
msgstr ""
"# 1. Basic GPU training (specifying Fold 0)\n"
"python train.py -m DKT -d assistments09 --data.fold 0\n"
"\n"
"# 2. Specify GPU device and adjust batch size and learning rate\n"
"python train.py -m AKT -d assistments09 --general.device cuda:1 "
"--model.batch_size 64 --model.learning_rate 1e-4\n"
"\n"
"# 3. Offline debugging (disable cloud tracking, skip test evaluation, "
"sample 500 students)\n"
"python train.py -m DKT -d assistments09 --general.cloud_tracking false "
"--general.skip_test true --data.sample_size 500\n"
"\n"
"# 4. Modify early stopping policy (monitor validation loss, patience 15 "
"epochs)\n"
"python train.py -m GIKT -d assistments09 --early_stopping.monitor loss "
"--early_stopping.mode min --early_stopping.patience 15\n"
"\n"
"# 5. Standalone evaluation of an experiment run directory\n"
"python evaluate.py --evaluate.run_dir "
"runs/normal/DKT_assistments09_20261109-133000_fold0_bs128\n"
"\n"
"# 6. Accelerate training using PyTorch Inductor graph compilation\n"
"python train.py -m SimpleKT -d assistments09 --compile.compile true "
"--compile.compile_mode default\n"
