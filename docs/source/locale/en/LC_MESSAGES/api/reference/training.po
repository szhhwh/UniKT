#: utils.training.base_trainer.BaseTrainer.add_callback:1
msgid "Append a callback to the active run after construction."
msgstr "Append a callback to the active run after construction."

#: c4b60bef7f4e41b297420487be347c4b of
#: utils.training.base_trainer.BaseTrainer.add_callback:3
msgid ""
"Single-stage trainers already have a live callback list (built in "
":meth:`build`). Multi-stage trainers build their per-stage callback "
"manager lazily from ``_custom_callbacks`` — registering there ensures the"
" callback runs in every stage."
msgstr ""
"Single-stage trainers already have a live callback list (built in "
":meth:`build`). Multi-stage trainers build their per-stage callback "
"manager lazily from ``_custom_callbacks`` — registering there ensures the"
" callback runs in every stage."

