#: ../../source/api/reference/training.md:1 9c942046dd3e436d95a95191e667a51c
msgid "训练基础设施"
msgstr "Training infrastructure"

#: ../../source/api/reference/training.md:3 f60905e73ca348969410619079d10ba7
msgid "训练器基类与多阶段训练器、运行时组件容器、指标累积、回调、检查点、指标记录后端。"
msgstr ""
"Trainer base classes and multi-stage trainers, runtime component "
"containers, metric accumulation, callbacks, checkpoints, and metric "
"logging backends."

#: 2250608434954fa2888825539fc8c174 of utils.training.base_trainer:1
msgid "Base trainer module."
msgstr "Base trainer module."

#: 177dea265ced4debb9ad9cc951b9fc6f of utils.training.base_trainer:3
msgid ""
"Provides the core trainer functionality including device management, data"
" loading, training loops, callbacks, checkpointing, and metric logging."
msgstr ""
"Provides the core trainer functionality including device management, data"
" loading, training loops, callbacks, checkpointing, and metric logging."

#: fd878350347d4267895e78f9af49d049 of
#: utils.training.base_trainer.BaseTrainer:1
msgid "Abstract base class for trainers."
msgstr "Abstract base class for trainers."

#: 7f845cafdaf843fcb28e02ab83c8190c of
#: utils.training.base_trainer.BaseTrainer:3
msgid "A single-stage trainer is constructed in one step::"
msgstr "A single-stage trainer is constructed in one step::"

#: b50089c11fd04789a333a8a40171be1b of
#: utils.training.base_trainer.BaseTrainer:5
msgid ""
"trainer = MyTrainer(rc, data_src, exp_manager)\n"
"trainer.run()"
msgstr ""
"trainer = MyTrainer(rc, data_src, exp_manager)\n"
"trainer.run()"

#: d187e95ca39b406fa4edb53f9fb3b9c0 of
#: utils.training.base_trainer.BaseTrainer:8
msgid ""
"The constructor wires everything: it calls :meth:`build_components` to "
"let the subclass assemble the model/optimizer/data from ``rc`` + "
"``data_src``, reads :meth:`build_callbacks` for any extra callbacks, then"
" runs :meth:`build` to finalize device, loaders, early stopping, logging "
"and checkpointing."
msgstr ""
"The constructor wires everything: it calls :meth:`build_components` to "
"let the subclass assemble the model/optimizer/data from ``rc`` + "
"``data_src``, reads :meth:`build_callbacks` for any extra callbacks, then"
" runs :meth:`build` to finalize device, loaders, early stopping, logging "
"and checkpointing."

#: 329e2d8a4f2e4ca98ffd37faea3ad914 of
#: utils.training.base_trainer.BaseTrainer:14
msgid "Subclasses implement:"
msgstr "Subclasses implement:"

#: 698a6afddf7045b0b3039e12463d6c89 of
#: utils.training.base_trainer.BaseTrainer:16
msgid ""
":meth:`build_components`: Return a :class:`RuntimeComponents` holding the"
" model, optimizer, loss, scheduler, and train/val/test data built from "
"``rc`` + ``data_src``. Scalar knobs are read from ``rc`` directly, never "
"stored on the components."
msgstr ""
":meth:`build_components`: Return a :class:`RuntimeComponents` holding the"
" model, optimizer, loss, scheduler, and train/val/test data built from "
"``rc`` + ``data_src``. Scalar knobs are read from ``rc`` directly, never "
"stored on the components."

#: 4956728505a44f62a796ab3f82082c83 of
#: utils.training.base_trainer.BaseTrainer:20
msgid ":meth:`build_callbacks`: Return extra callbacks (default ``[]``)."
msgstr ":meth:`build_callbacks`: Return extra callbacks (default ``[]``)."

#: dcdc238e75e44036abb6aa6917a58c52 of
#: utils.training.base_trainer.BaseTrainer:21
msgid ":meth:`forward_pass`: Model forward pass for one batch."
msgstr ":meth:`forward_pass`: Model forward pass for one batch."

#: c6400d21f0f847aaa0b8a1ef70cc4d66 of
#: utils.training.base_trainer.BaseTrainer:22
msgid ""
":meth:`_compute_loss`: Training loss (default ``self.loss(y_hat, "
"y_label)``); auxiliary terms added here are excluded from val/test loss, "
"which always goes through :meth:`_compute_eval_loss`."
msgstr ""
":meth:`_compute_loss`: Training loss (default ``self.loss(y_hat, "
"y_label)``); auxiliary terms added here are excluded from val/test loss, "
"which always goes through :meth:`_compute_eval_loss`."

