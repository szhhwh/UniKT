"├── MyKT_model.py    # 纯净的 PyTorch 计算图，继承 nn.Module\n"
"├── MyKT_data.py     # 序列特征准备与批切分，继承 QuestionModelData 或 SkillModelData\n"
"└── MyKT_trainer.py  # 训练循环装配与超参数注册，继承 BaseTrainer 与 ModelConfig\n"
