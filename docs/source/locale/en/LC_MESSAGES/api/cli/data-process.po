#: ../../source/api/cli/data-process.md:76 a98393f2db0649e88105acd9cff0cbe8
msgid ""
"# 1. 标准全流程处理：生成 5 折切分与题目级/知识点级序列\n"
"python data_process.py process -d assistments09\n"
"\n"
"# 2. 生成带有 windowlate 窗口测试评估集的数据\n"
"python data_process.py process -d assistments09 --extra windowlate\n"
"\n"
"# 3. 在大型数据集上抽取 10% 学生并生成测试集\n"
"python data_process.py process -d ednet_kt1 --data.sample_ratio 0.1 "
"--data.sample_strategy stratified\n"
msgstr ""
"# 1. Standard full-pipeline processing: generate 5-fold split and "
"question/skill-level sequences\n"
"python data_process.py process -d assistments09\n"
"\n"
"# 2. Generate data with windowlate windowed evaluation benchmark set\n"
"python data_process.py process -d assistments09 --extra windowlate\n"
"\n"
"# 3. Sample 10% students on large datasets and generate test set\n"
"python data_process.py process -d ednet_kt1 --data.sample_ratio 0.1 "
"--data.sample_strategy stratified\n"

