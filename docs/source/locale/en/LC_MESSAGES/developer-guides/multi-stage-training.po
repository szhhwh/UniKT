#: ../../source/developer-guides/multi-stage-training.md:41
#: 3448f922c4c64e4f9995269682d5594a
msgid "2. StageComponents"
msgstr "2\\. StageComponents"

#: ../../source/developer-guides/multi-stage-training.md:42
#: e58231bdf4c24085be4fb1de7def4ab7
msgid "封装单阶段训练所需的独立运行时组件："
msgstr "Encapsulates independent runtime components required for a single stage:"

#: ../../source/developer-guides/multi-stage-training.md:43
#: b70e66153b23407d8ac7afd85a5425b0
msgid ""
"@dataclass\n"
"class StageComponents:\n"
"    model: torch.nn.Module  # 该阶段的模型\n"
"    optimizer: torch.optim.Optimizer  # 该阶段的优化器\n"
"    loss_fn: torch.nn.Module  # 该阶段的损失函数\n"
"    train_data: Any  # 该阶段的训练数据（DataLoader 或 Dataset）\n"
"    val_data: Any | None = None  # 验证数据（可选）\n"
"    test_data: Any | None = None  # 测试数据（可选）\n"
"    epochs: int = 100  # 该阶段运行轮数\n"
"    lr_scheduler: Any | None = None  # 学习率调度器（可选）\n"
"    early_stopping: EarlyStoppingConfig | None = None  # 早停配置对象（非构造实例）\n"
"    max_clip_grad_norm: float | None = None  # 梯度裁剪阈值\n"
"    checkpoint_monitor: str | None = None  # 最佳模型监控指标（如 \"auc\"）\n"
"    checkpoint_mode: str | None = None  # 监控模式（\"max\" 或 \"min\"）\n"
msgstr ""
"@dataclass\n"
"class StageComponents:\n"
"    model: torch.nn.Module  # Stage model\n"
"    optimizer: torch.optim.Optimizer  # Stage optimizer\n"
"    loss_fn: torch.nn.Module  # Stage loss function\n"
"    train_data: Any  # Stage training data (DataLoader or Dataset)\n"
"    val_data: Any | None = None  # Validation data (optional)\n"
"    test_data: Any | None = None  # Test data (optional)\n"
"    epochs: int = 100  # Number of epochs for this stage\n"
"    lr_scheduler: Any | None = None  # Learning rate scheduler (optional)"
"\n"
"    early_stopping: EarlyStoppingConfig | None = None  # Early stopping "
"configuration (not constructed instance)\n"
"    max_clip_grad_norm: float | None = None  # Gradient clipping "
"threshold\n"
"    checkpoint_monitor: str | None = None  # Best checkpoint monitor "
"metric (e.g. \"auc\")\n"
"    checkpoint_mode: str | None = None  # Monitor mode (\"max\" or "
"\"min\")\n"

