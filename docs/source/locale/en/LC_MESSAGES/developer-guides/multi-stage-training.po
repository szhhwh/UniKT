"from dataclasses import field\n"
"from typing import Literal\n"
"from utils.config import ModelConfig\n"
"from utils.core import register_model_config\n"
"\n"
"\n"
"@register_model_config(\"ABKT\")\n"
"class ABKTConfig(ModelConfig):\n"
"    \"\"\"ABKT multi-stage hyperparameter configuration.\"\"\"\n"
"\n"
"    # KM stage hyperparameters\n"
"    km_hidden_dim: int = 5\n"
"    km_lr: float = 1e-3\n"
"    km_epochs: int = 100\n"
"    km_patience: int = 10\n"
"\n"
"    # AM stage hyperparameters\n"
"    am_embedding_dim: int = 50\n"
"    am_lr: float = 1e-4\n"
"    am_epochs: int = 500\n"
"    am_patience: int = 10\n"
"    am_lambda: float = 0.1  # Regularization weight\n"
"\n"
"    # Multi-stage fusion mode\n"
