msgid "Pixi 同样封装了项目级常用脚本："
msgstr "Pixi also packages frequently used project scripts:"

#: ../../source/getting-started/installation.md:224
#: c046da321aa54098814d04f88cf97058
msgid ""
"# 代码风格检查与格式化\n"
"pixi run lint       # ruff check\n"
"pixi run fmt        # ruff format\n"
"pixi run ckf        # lint + fmt + mypy 类型检查\n"
"\n"
"# 文档构建任务\n"
"pixi run docs-build # 编译中文官方 HTML 文档\n"
"pixi run docs-dev   # 启动本地热重载文档预览服务\n"
"\n"
"# Web 平台任务\n"
"pixi run web-backend # 启动 FastAPI 后端 (8765 端口)\n"
"pixi run web-frontend# 启动 Vite 前端开发服务器\n"
"pixi run web-dev     # 并发启动前后端服务\n"
msgstr ""
"# Code style checking and formatting\n"
"pixi run lint       # ruff check\n"
"pixi run fmt        # ruff format\n"
"pixi run ckf        # lint + fmt + mypy type checking\n"
"\n"
"# Documentation build tasks\n"
"pixi run docs-build # Build Chinese official HTML documentation\n"
"pixi run docs-dev   # Start local hot-reloading documentation server\n"
"\n"
"# Web platform tasks\n"
"pixi run web-backend # Start FastAPI backend (port 8765)\n"
"pixi run web-frontend# Start Vite frontend dev server\n"
"pixi run web-dev     # Start both backend and frontend concurrently\n"
