msgstr "Inference Stage (`--efficiency.inference.*`)"

#: ../../source/api/cli/efficiency.md:48 a5dc789378b64d4191c2dcd632bf2167
msgid "`--efficiency.inference.iters` (`int`, 默认 `100`)：推断计时测量的迭代次数。"
msgstr ""
"`--efficiency.inference.iters` (`int`, default `100`): Number of "
"iterations for inference timing measurements."

#: ../../source/api/cli/efficiency.md:49 c3e31b6c24144dc7bfac0a320fb6bdaf
msgid ""
"`--efficiency.inference.cuda_graph` (`bool`, 默认 `False`)：是否使用 CUDA Graph "
"录制加速。"
msgstr ""
"`--efficiency.inference.cuda_graph` (`bool`, default `False`): Whether to"
" accelerate using CUDA Graph capture."

#: ../../source/api/cli/efficiency.md:51 a0c4e23383ba4b4da2e36ffa23b32b63
msgid "训练阶段 (`--efficiency.training.*`)"
msgstr "Training Stage (`--efficiency.training.*`)"

#: ../../source/api/cli/efficiency.md:52 7ffb76c477734668ab103aeded189371
msgid "`--efficiency.training.iters` (`int`, 默认 `100`)：前向 + 反向 + 优化器单步更新的计时迭代次数。"
msgstr ""
"`--efficiency.training.iters` (`int`, default `100`): Number of timing "
"iterations for forward + backward + optimizer step update."

#: ../../source/api/cli/efficiency.md:54 354e3dc54225489b9a384f1c37d804a9
msgid "算子画像与剖析 (`--efficiency.trace.*`)"
msgstr "Operator Profiling and Tracing (`--efficiency.trace.*`)"

