"    batch_size: int = 128"

#: ../../source/developer-guides/multi-stage-training.md:97
#: cb1b91ad8469436e9a7c147322529a6e
msgid "第二步：继承 MultiTrainer 并声明阶段列表"
msgstr "Step 2: Inherit MultiTrainer and Declare Stages"

#: ../../source/developer-guides/multi-stage-training.md:99
#: 020fcf63172c4155a1335af3d5185d5f
msgid "训练器在 `__init__` 中只做跨阶段通用的数据预备（如解析 Q 矩阵与用户交互记录），通过 `build_stages` 声明阶段顺序："
msgstr ""
"The trainer prepares cross-stage shared data (e.g., Q-matrices, "
"interaction records) in `__init__` and declares stage order via "
"`build_stages`:"

#: ../../source/developer-guides/multi-stage-training.md:101
#: 29ccefa2a6594a25b207db917534df87
msgid ""
"from utils.core import register_trainer\n"
"from utils.training import MultiTrainer, StageComponents, StageConfig\n"
"\n"
"\n"
"@register_trainer(\"ABKT\")\n"
"class ABKTTrainer(MultiTrainer):\n"
"    def __init__(self, rc, data_src, exp_manager=None):\n"
"        # 1. 准备跨阶段共享数据（在调用 super 之前）\n"
"        from .ABKT_data import ABKTModelData\n"
"\n"
"        self.model_data = ABKTModelData(data_src)\n"
"        self.data = self.model_data.prepare_data(rc)\n"
"\n"
"        # 2. 跨阶段状态槽位（将在阶段完成时由 hook 填充）\n"
"        self.km_model = None\n"
"        self.am_model = None\n"
"        self.am_train_triplets = None\n"
"        self.am_test_triplets = None\n"
"\n"
"        super().__init__(rc, data_src, exp_manager)\n"
"\n"
"    def build_stages(self) -> list[StageConfig]:\n"
"        \"\"\"返回阶段执行顺序。构建器函数延迟执行。\"\"\"\n"
"        return [\n"
"            StageConfig(name=\"km\", build=self._build_km),\n"
"            StageConfig(name=\"am\", build=self._build_am),\n"
"        ]\n"
msgstr ""
"from utils.core import register_trainer\n"
"from utils.training import MultiTrainer, StageComponents, StageConfig\n"
"\n"
"\n"
"@register_trainer(\"ABKT\")\n"
"class ABKTTrainer(MultiTrainer):\n"
"    def __init__(self, rc, data_src, exp_manager=None):\n"
"        # 1. Prepare data shared across stages (before calling super)\n"
"        from .ABKT_data import ABKTModelData\n"
"\n"
"        self.model_data = ABKTModelData(data_src)\n"
"        self.data = self.model_data.prepare_data(rc)\n"
"\n"
"        # 2. Cross-stage state slots (filled by hooks when a stage "
"completes)\n"
"        self.km_model = None\n"
"        self.am_model = None\n"
"        self.am_train_triplets = None\n"
"        self.am_test_triplets = None\n"
"\n"
"        super().__init__(rc, data_src, exp_manager)\n"
"\n"
"    def build_stages(self) -> list[StageConfig]:\n"
"        \"\"\"Return the stage execution order. Builder functions run "
"lazily.\"\"\"\n"
"        return [\n"
"            StageConfig(name=\"km\", build=self._build_km),\n"
"            StageConfig(name=\"am\", build=self._build_am),\n"
"        ]"

#: ../../source/developer-guides/multi-stage-training.md:131
#: a190d1af9f444d828130a4f928437fb7
msgid "第三步：实现各个阶段的延迟构建方法"
msgstr "Step 3: Implement Lazy Stage Builders"

#: ../../source/developer-guides/multi-stage-training.md:133
#: 72e6efef89d9473bb4929b7ed7f43985
msgid "每个阶段独立组装网络、优化器与数据集："
msgstr "Each stage independently instantiates networks, optimizers, and datasets:"

#: ../../source/developer-guides/multi-stage-training.md:135
#: 6c1080e1aa8a40b0bf78f8c1a5ad3ee1
msgid ""
"    def _build_km(self) -> StageComponents:\n"
"        \"\"\"构建第一阶段：KM 知识模块。\"\"\"\n"
"        m = self.run_config.model\n"
"        from .ABKT_model import K_CMF\n"
"\n"
"        # 实例化 KM 模型\n"
"        self.km_model = K_CMF(\n"
"            k_hidden_size=m.km_hidden_dim,\n"
"            skill_num=self.data[\"num_skills\"],\n"
"            user_num=self.data[\"num_users\"],\n"
"            item_num=self.data[\"num_items\"],\n"
"            q_matrix=self.data[\"Q_matrix\"].to(self.device_),\n"
"        )\n"
"\n"
"        train_loader = self.data[\"km_train_loader\"]\n"
"        val_loader = self.data[\"km_val_loader\"]\n"
"\n"
"        optimizer = torch.optim.Adam(self.km_model.parameters(), "
"lr=m.km_lr)\n"
"\n"
"        return StageComponents(\n"
"            model=self.km_model,\n"
"            optimizer=optimizer,\n"
"            loss_fn=torch.nn.BCELoss(),\n"
"            train_data=train_loader,\n"
"            val_data=val_loader,\n"
"            epochs=m.km_epochs,\n"
"            early_stopping=EarlyStoppingConfig(\n"
"                monitor=\"auc\", mode=\"max\", patience=m.km_patience\n"
"            ),\n"
"        )\n"
"\n"
"    def _build_am(self) -> StageComponents:\n"
"        \"\"\"构建第二阶段：AM 能力残差模块。\n"
"\n"
"        注意：此时 KM 阶段已完全结束，self.am_train_triplets 已由 hook 准备就绪。\n"
"        \"\"\"\n"
"        m = self.run_config.model\n"
"        from .ABKT_model import GMF\n"
"\n"
"        if self.am_train_triplets is None:\n"
"            raise RuntimeError(\"AM 阶段构建前必须先计算 Boosting 残差！\")\n"
"\n"
"        self.am_model = GMF(\n"
"            n_users=self.data[\"num_users\"],\n"
"            n_items=self.data[\"num_items\"],\n"
"            embedding_k=m.am_embedding_dim,\n"
"        )\n"
"\n"
"        # 基于 KM 残差创建 AM 数据加载器\n"
"        from utils.model_data import create_optimized_dataloader\n"
"\n"
"        train_loader = create_optimized_dataloader(\n"
"            self.am_train_triplets,\n"
"            batch_size=m.batch_size,\n"
"            shuffle=True,\n"
"            device=self.device_,\n"
"        )\n"
"        val_loader = create_optimized_dataloader(\n"
"            self.am_test_triplets,\n"
"            batch_size=m.batch_size,\n"
"            shuffle=False,\n"
"            device=self.device_,\n"
"        )\n"
"\n"
"        optimizer = torch.optim.Adam(self.am_model.parameters(), "
"lr=m.am_lr)\n"
"        loss_fn = AMLoss(am_lambda=m.am_lambda, "
"combine_mode=m.combine_mode)\n"
"\n"
"        return StageComponents(\n"
"            model=self.am_model,\n"
"            optimizer=optimizer,\n"
"            loss_fn=loss_fn,\n"
"            train_data=train_loader,\n"
"            val_data=val_loader,\n"
"            epochs=m.am_epochs,\n"
"            early_stopping=EarlyStoppingConfig(\n"
"                monitor=\"auc\", mode=\"max\", patience=m.am_patience\n"
"            ),\n"
"        )\n"
msgstr ""
"    def _build_km(self) -> StageComponents:\n"
"        \"\"\"Build stage 1: KM knowledge module.\"\"\"\n"
"        m = self.run_config.model\n"
"        from .ABKT_model import K_CMF\n"
"\n"
"        # Instantiate KM model\n"
"        self.km_model = K_CMF(\n"
"            k_hidden_size=m.km_hidden_dim,\n"
"            skill_num=self.data[\"num_skills\"],\n"
"            user_num=self.data[\"num_users\"],\n"
"            item_num=self.data[\"num_items\"],\n"
"            q_matrix=self.data[\"Q_matrix\"].to(self.device_),\n"
"        )\n"
"\n"
"        train_loader = self.data[\"km_train_loader\"]\n"
"        val_loader = self.data[\"km_val_loader\"]\n"
"\n"
"        optimizer = torch.optim.Adam(self.km_model.parameters(), "
"lr=m.km_lr)\n"
"\n"
"        return StageComponents(\n"
"            model=self.km_model,\n"
"            optimizer=optimizer,\n"
"            loss_fn=torch.nn.BCELoss(),\n"
"            train_data=train_loader,\n"
"            val_data=val_loader,\n"
"            epochs=m.km_epochs,\n"
"            early_stopping=EarlyStoppingConfig(\n"
"                monitor=\"auc\", mode=\"max\", patience=m.km_patience\n"
"            ),\n"
"        )\n"
"\n"
"    def _build_am(self) -> StageComponents:\n"
"        \"\"\"Build stage 2: AM ability residual module.\n"
"\n"
"        Note: KM stage is finished; self.am_train_triplets is prepared by"
" hook.\n"
"        \"\"\"\n"
"        m = self.run_config.model\n"
"        from .ABKT_model import GMF\n"
"\n"
"        if self.am_train_triplets is None:\n"
"            raise RuntimeError(\"Boosting residuals must be computed "
"before AM stage!\")\n"
"\n"
"        self.am_model = GMF(\n"
"            n_users=self.data[\"num_users\"],\n"
"            n_items=self.data[\"num_items\"],\n"
"            embedding_k=m.am_embedding_dim,\n"
"        )\n"
"\n"
"        # Create AM dataloaders based on KM residuals\n"
"        from utils.model_data import create_optimized_dataloader\n"
"\n"
"        train_loader = create_optimized_dataloader(\n"
"            self.am_train_triplets,\n"
"            batch_size=m.batch_size,\n"
"            shuffle=True,\n"
"            device=self.device_,\n"
"        )\n"
"        val_loader = create_optimized_dataloader(\n"
"            self.am_test_triplets,\n"
"            batch_size=m.batch_size,\n"
"            shuffle=False,\n"
"            device=self.device_,\n"
"        )\n"
"\n"
"        optimizer = torch.optim.Adam(self.am_model.parameters(), "
"lr=m.am_lr)\n"
"        loss_fn = AMLoss(am_lambda=m.am_lambda, "
"combine_mode=m.combine_mode)\n"
"\n"
"        return StageComponents(\n"
"            model=self.am_model,\n"
"            optimizer=optimizer,\n"
"            loss_fn=loss_fn,\n"
"            train_data=train_loader,\n"
"            val_data=val_loader,\n"
"            epochs=m.am_epochs,\n"
"            early_stopping=EarlyStoppingConfig(\n"
"                monitor=\"auc\", mode=\"max\", patience=m.am_patience\n"
"            ),\n"
"        )\n"

