#: ../../source/developer-guides/customize-model.md:38
#: 248611b3309d4e4ba77f889dd17045aa
msgid "知识追踪模型通常有两种经典的序列预测语义："
msgstr ""
"Knowledge tracing models generally adopt two classic sequence prediction "
"semantics:"

#: ../../source/developer-guides/customize-model.md:39
#: f7093656dff34ac4ba99d937a3466770
msgid ""
"**Next-item 预测**：主流默认范式。在 $t$ 时刻根据历史答题特征预测 $t+1$ 时刻的作答正确率，模型输出张量长度通常为 "
"$S-1$ 或 $S$。"
msgstr ""
"**Next-item Prediction**: Mainstream default paradigm. Predicts question "
"correctness at step $t+1$ using historical response features up to step "
"$t$; the output tensor length is typically $S-1$ or $S$."

#: ../../source/developer-guides/customize-model.md:40
#: 0bfe451026444bd88f981d08e48712b2
msgid ""
"**Same-position 预测**：适用于 DKT 或 DKVMN 等结构。模型在前向过程中利用全部 $S$ 个时刻的表征输出 $S$ "
"维预测；此时输入需保证因果掩码，第 $t$ 步的输出对应第 $t$ 步的目标标签。"
msgstr ""
"**Same-position Prediction**: Suitable for architectures like DKT or "
"DKVMN. The model produces $S$-dimensional predictions using "
"representations across all $S$ timesteps; inputs must enforce causal "
"masking, where output at step $t$ aligns with target label at step $t$."

#: ../../source/developer-guides/customize-model.md:42
#: a848ac38487a48e0acfc0fcac060480f
msgid "在 `MyKT_model.py` 中，我们以标准的 Next-item 循环神经网络为例："
msgstr ""
"In `MyKT_model.py`, we take a standard Next-item recurrent neural network"
" as an example:"

#: ../../source/developer-guides/customize-model.md:44
#: 068352d5322c445c9399214273507bd9
msgid ""
"\"\"\"MyKT: 自定义轻量循环知识追踪网络模型。\"\"\"\n"
"\n"
"import torch\n"
"import torch.nn as nn\n"
"\n"
"\n"
"class MyKTNet(nn.Module):\n"
"    \"\"\"MyKT 神经网络模型。\n"
"\n"
"    Args:\n"
"        num_questions: 数据集中题目总数。\n"
"        num_skills: 数据集中知识点总数。\n"
"        embedding_dim: 嵌入向量维度。\n"
"        hidden_dim: LSTM 隐藏层神经元数。\n"
"        dropout: 随机失活概率。\n"
"    \"\"\"\n"
"\n"
"    def __init__(\n"
"        self,\n"
"        num_questions: int,\n"
"        num_skills: int,\n"
"        embedding_dim: int = 128,\n"
"        hidden_dim: int = 128,\n"
"        dropout: float = 0.2,\n"
"    ):\n"
"        super().__init__()\n"
"        self.embedding_dim = embedding_dim\n"
"        self.hidden_dim = hidden_dim\n"
"\n"
"        # 题目与作答的嵌入层 (0 为 padding，真实题目从 1 开始)\n"
"        self.question_embed = nn.Embedding(\n"
"            num_questions + 1, embedding_dim, padding_idx=0\n"
"        )\n"
"        self.skill_embed = nn.Embedding(num_skills + 1, embedding_dim, "
"padding_idx=0)\n"
"        # 答题标签 (0 或 1) 嵌入\n"
"        self.response_embed = nn.Embedding(2, embedding_dim)\n"
"\n"
"        self.dropout = nn.Dropout(dropout)\n"
"        # 输入维度: 题目嵌入 + 作答嵌入\n"
"        self.lstm = nn.LSTM(\n"
"            input_size=embedding_dim * 2,\n"
"            hidden_size=hidden_dim,\n"
"            batch_first=True,\n"
"        )\n"
"        # 预测头：预测下一次答题对错概率的 logit\n"
"        self.fc = nn.Sequential(\n"
"            nn.Linear(hidden_dim, hidden_dim // 2),\n"
"            nn.ReLU(),\n"
"            nn.Dropout(dropout),\n"
"            nn.Linear(hidden_dim // 2, 1),\n"
"        )\n"
"\n"
"    def forward(\n"
"        self,\n"
"        question: torch.Tensor,\n"
"        response: torch.Tensor,\n"
"        mask: torch.Tensor,\n"
"        skill: torch.Tensor | None = None,\n"
"    ) -> torch.Tensor:\n"
"        \"\"\"前向传播计算。\n"
"\n"
"        Args:\n"
"            question: 题目 ID 序列 [batch_size, seq_len]\n"
"            response: 作答结果序列 (0/1) [batch_size, seq_len]\n"
"            mask: 有效位置布尔掩码 [batch_size, seq_len]\n"
"            skill: 知识点 ID 序列（可选）[batch_size, seq_len]\n"
"\n"
"        Returns:\n"
"            预测概率或 logits，形状为 [batch_size, seq_len] 或 [batch_size, seq_len"
" - 1]\n"
"        \"\"\"\n"
"        # 1. 编码交互特征：当前题目嵌入 + 当前作答嵌入\n"
"        q_emb = self.question_embed(question)  # [B, S, D]\n"
"        r_emb = self.response_embed(response)  # [B, S, D]\n"
"        interaction_emb = torch.cat([q_emb, r_emb], dim=-1)  # [B, S, 2D]"
"\n"
"        interaction_emb = self.dropout(interaction_emb)\n"
"\n"
"        # 2. 序列建模\n"
"        h, _ = self.lstm(interaction_emb)  # [B, S, H]\n"
"\n"
"        # 3. 预测概率（经过 Sigmoid 激活输出 0~1 的预测值）\n"
"        logits = self.fc(h).squeeze(-1)  # [B, S]\n"
"        y_hat = torch.sigmoid(logits)\n"
"\n"
"        return y_hat\n"
msgstr ""
"\"\"\"MyKT: Custom lightweight recurrent knowledge tracing network.\"\"\""
"\n"
"\n"
"import torch\n"
"import torch.nn as nn\n"
"\n"
"\n"
"class MyKTNet(nn.Module):\n"
"    \"\"\"MyKT neural network model.\n"
"\n"
"    Args:\n"
"        num_questions: Total number of questions in dataset.\n"
"        num_skills: Total number of skills in dataset.\n"
"        embedding_dim: Embedding dimension.\n"
"        hidden_dim: LSTM hidden dimension.\n"
"        dropout: Dropout probability.\n"
"    \"\"\"\n"
"\n"
"    def __init__(\n"
"        self,\n"
"        num_questions: int,\n"
"        num_skills: int,\n"
"        embedding_dim: int = 128,\n"
"        hidden_dim: int = 128,\n"
"        dropout: float = 0.2,\n"
"    ):\n"
"        super().__init__()\n"
"        self.embedding_dim = embedding_dim\n"
"        self.hidden_dim = hidden_dim\n"
"\n"
"        # Question and response embeddings (0 is padding, valid questions"
" start from 1)\n"
"        self.question_embed = nn.Embedding(\n"
"            num_questions + 1, embedding_dim, padding_idx=0\n"
"        )\n"
"        self.skill_embed = nn.Embedding(num_skills + 1, embedding_dim, "
"padding_idx=0)\n"
"        # Response outcome (0 or 1) embedding\n"
"        self.response_embed = nn.Embedding(2, embedding_dim)\n"
"\n"
"        self.dropout = nn.Dropout(dropout)\n"
"        # Input: question embedding + response embedding\n"
"        self.lstm = nn.LSTM(\n"
"            input_size=embedding_dim * 2,\n"
"            hidden_size=hidden_dim,\n"
"            batch_first=True,\n"
"        )\n"
"        # Prediction head: predicts next question correctness logit\n"
"        self.fc = nn.Sequential(\n"
"            nn.Linear(hidden_dim, hidden_dim // 2),\n"
"            nn.ReLU(),\n"
"            nn.Dropout(dropout),\n"
"            nn.Linear(hidden_dim // 2, 1),\n"
"        )\n"
"\n"
"    def forward(\n"
"        self,\n"
"        question: torch.Tensor,\n"
"        response: torch.Tensor,\n"
"        mask: torch.Tensor,\n"
"        skill: torch.Tensor | None = None,\n"
"    ) -> torch.Tensor:\n"
"        \"\"\"Forward propagation.\n"
"\n"
"        Args:\n"
"            question: Question ID sequence [batch_size, seq_len]\n"
"            response: Response sequence (0/1) [batch_size, seq_len]\n"
"            mask: Valid position boolean mask [batch_size, seq_len]\n"
"            skill: Skill ID sequence (optional) [batch_size, seq_len]\n"
"\n"
"        Returns:\n"
"            Predicted probabilities or logits [batch_size, seq_len]\n"
"        \"\"\"\n"
"        # 1. Encode interaction features: current question + current "
"response\n"
"        q_emb = self.question_embed(question)  # [B, S, D]\n"
"        r_emb = self.response_embed(response)  # [B, S, D]\n"
"        interaction_emb = torch.cat([q_emb, r_emb], dim=-1)  # [B, S, 2D]"
"\n"
"        interaction_emb = self.dropout(interaction_emb)\n"
"\n"
"        # 2. Sequence modeling\n"
"        h, _ = self.lstm(interaction_emb)  # [B, S, H]\n"
"\n"
"        # 3. Prediction probabilities (sigmoid activation produces 0~1 "
"range)\n"
"        logits = self.fc(h).squeeze(-1)  # [B, S]\n"
"        y_hat = torch.sigmoid(logits)\n"
"\n"
"        return y_hat\n"

