#: ../../source/user-guides/training.md:118 c057d3f705324929885b77455498bd68
msgid "运行产物结构"
msgstr "Run Artifact Structure"

#: ../../source/user-guides/training.md:120 709c3312e57446aa9fa289db100eb2d1
msgid "每次训练会在 `runs/normal/<run_id>/` 目录下生成完整的实验归档文件："
msgstr ""
"Each training run generates a comprehensive experiment archive under "
"`runs/normal/<run_id>/`:"

#: ../../source/user-guides/training.md:122 f56f27726e594898ae99903905cc8116
msgid ""
"runs/normal/GIKT_assistments09_20261109-120000_fold0_bs128/\n"
"├── best_model.pth          # 验证集监控指标最优时的模型权重\n"
"├── last_checkpoint.pth     # 最后一轮训练完成后的权重（若启用）\n"
"├── run_config.yaml         # 类型完整的配置归档（支持无损重跑与配置复现）\n"
"├── run_metadata.yaml       # 运行元数据（包含参数量、硬件环境、PyTorch 版本等）\n"
"├── metrics_train.csv       # 训练集各轮次 Loss 与评价指标记录\n"
"├── metrics_val.csv         # 验证集各轮次指标记录\n"
"├── metrics_test.csv        # 测试集最终评价指标记录\n"
"├── run.log                 # 完整控制台日志记录\n"
"└── evaluate/               # 若运行了 evaluate.py，生成的独立评估日志目录\n"
msgstr ""
"runs/normal/GIKT_assistments09_20261109-120000_fold0_bs128/\n"
"├── run_config.yaml         # Complete static configuration snapshot\n"
"├── run_metadata.yaml       # Dynamic runtime metadata\n"
"├── metrics_train.csv       # Training metric history\n"
"├── metrics_val.csv         # Validation metric history\n"
"├── metrics_test.csv        # Test set final metrics\n"
"├── best_model.pth          # Best model weights\n"
"└── run.log                 # Complete console log\n"
