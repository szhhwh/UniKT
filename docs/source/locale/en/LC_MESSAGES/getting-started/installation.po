msgstr "cp .env.example .env\n"

#: ../../source/getting-started/installation.md:151
#: 6ab83e94604944229584ee55f6d72a11
msgid "打开 `.env` 文件，根据需求填入相应的配置项："
msgstr "Open `.env` and configure the settings according to your needs:"

#: ../../source/getting-started/installation.md:153
#: bc651588dba148aca0b18093b24379d8
msgid ""
"# Lark (飞书) 训练完成/异常 Webhook 通知（可选）\n"
"LARK_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx\n"
"LARK_SECRET=\n"
"\n"
"# 实验追踪后端类型: swanlab | wandb (默认: swanlab)\n"
"KT_TRACKING_BACKEND=swanlab\n"
"\n"
"# SwanLab 实验追踪配置\n"
"# 模式可选: cloud (云端同步) 或 local (本地离线记录)\n"
"SWANLAB_MODE=cloud\n"
"KT_SWANLAB_WORKSPACE=my-workspace\n"
"KT_SWANLAB_PROJECT=UniKT-Experiments\n"
"\n"
"# Weights & Biases (W&B) 配置 (当 KT_TRACKING_BACKEND=wandb 时生效)\n"
"KT_WANDB_PROJECT=UniKT\n"
"KT_WANDB_ENTITY=my-team\n"
"\n"
"# 全局日志输出级别: DEBUG, INFO, WARNING, ERROR (默认: INFO)\n"
"LOG_LEVEL=INFO\n"
"\n"
"# 异步指标日志落盘 (1 = 后台独立线程写入, 0 = 同步阻塞写入)\n"
"METRIC_LOGGING_ASYNC=1\n"
"\n"
"# Web 前端预览服务默认端口\n"
"KT_WEB_PORT=5173\n"
msgstr ""
"# Lark (Feishu) Webhook for training finish/exception notifications "
"(optional)\n"
"LARK_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx\n"
"LARK_SECRET=\n"
"\n"
"# Experiment tracking backend: swanlab | wandb (default: swanlab)\n"
"KT_TRACKING_BACKEND=swanlab\n"
"\n"
"# SwanLab experiment tracking configuration\n"
"# Mode choices: cloud (sync to cloud) or local (offline local records)\n"
"SWANLAB_MODE=cloud\n"
"KT_SWANLAB_WORKSPACE=my-workspace\n"
"KT_SWANLAB_PROJECT=UniKT-Experiments\n"
"\n"
"# Weights & Biases (W&B) configuration (effective when "
"KT_TRACKING_BACKEND=wandb)\n"
"KT_WANDB_PROJECT=UniKT\n"
"KT_WANDB_ENTITY=my-team\n"
"\n"
"# Global logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)\n"
"LOG_LEVEL=INFO\n"
"\n"
"# Asynchronous metric logging (1 = background thread write, 0 = "
"synchronous blocking write)\n"
"METRIC_LOGGING_ASYNC=1\n"
"\n"
"# Web frontend preview server default port\n"
"KT_WEB_PORT=5173\n"

#: ../../source/getting-started/installation.md:182
#: e9463bc0b85c4422948c1e3bd1f1e62a
msgid ""
"若使用 SwanLab 云端记录，建议在初次运行前执行 `swanlab login` 绑定个人或团队 API Key。若在离线集群上训练，可设置"
" `SWANLAB_MODE=local`，指标将仅保存在本地的 `runs/swanlog/` 目录中。"
msgstr ""
"If using SwanLab cloud tracking, run `swanlab login` to bind your "
"personal or team API key before the first run. On offline compute "
"clusters, set `SWANLAB_MODE=local` so metrics are stored solely in the "
"local `runs/swanlog/` directory."

