msgstr "`150`"

#: ../../source/api/cli/train.md fc448603a1d94a86bcae29171e334aa8
msgid "最大训练轮数（基类默认 150，具体模型可覆盖）"
msgstr ""
"Maximum training epochs (base class default 150, can be overridden by "
"specific models)"

#: ../../source/api/cli/train.md b4a0b96c259a462397dc2d1a524b171e
msgid "`--model.batch_size`"
msgstr "`--model.batch_size`"

#: ../../source/api/cli/train.md 05d23aa7d2d24cd5a9ada050f565b509
msgid "`32`"
msgstr "`32`"

#: ../../source/api/cli/train.md fb976455cb6247389448823fe5b4879d
msgid "训练批大小（基类默认 32，具体模型可覆盖，如 GIKT 默认 128）"
msgstr ""
"Training batch size (base class default 32, can be overridden by specific"
" models, e.g., GIKT defaults to 128)"

#: ../../source/api/cli/train.md 1aacbca837a847dea30a206e66721963
