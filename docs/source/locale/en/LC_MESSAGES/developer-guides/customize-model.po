#: ../../source/developer-guides/customize-model.md:160
#: fbbc92ef96074658956ce4e4332ff080
#, python-brace-format
msgid ""
"\"\"\"MyKT 模型数据加载与准备。\"\"\"\n"
"\n"
"from typing import Any\n"
"\n"
"import torch\n"
"from torch.utils.data import Dataset\n"
"from typing_extensions import override\n"
"\n"
"from utils.core import get_logger\n"
"from utils.data_process import DataSource\n"
"from utils.model_data import QuestionModelData\n"
"from utils.model_data.packed_sequences import to_first_skill_ids\n"
"\n"
"logger = get_logger(__name__)\n"
"\n"
"\n"
"class MyKTDataset(Dataset):\n"
"    \"\"\"MyKT 训练与验证样本集。\"\"\"\n"
"\n"
"    def __init__(\n"
"        self,\n"
"        questions: torch.Tensor,\n"
"        responses: torch.Tensor,\n"
"        masks: torch.Tensor,\n"
"        skills: torch.Tensor | None = None,\n"
"    ):\n"
"        self.questions = questions\n"
"        self.responses = responses\n"
"        self.masks = masks\n"
"        self.skills = skills\n"
"\n"
"    def __len__(self) -> int:\n"
"        return len(self.questions)\n"
"\n"
"    def __getitem__(self, idx: int) -> tuple[torch.Tensor, ...]:\n"
"        q = torch.tensor(self.questions[idx], dtype=torch.long)\n"
"        r = torch.tensor(self.responses[idx], dtype=torch.long)\n"
"        m = torch.tensor(self.masks[idx], dtype=torch.bool)\n"
"        if self.skills is not None:\n"
"            s = torch.tensor(self.skills[idx], dtype=torch.long)\n"
"            return q, r, m, s\n"
"        return q, r, m\n"
"\n"
"\n"
"class MyKTModelData(QuestionModelData):\n"
"    \"\"\"MyKT 数据准备处理器。\"\"\"\n"
"\n"
"    def __init__(self, data_src: DataSource):\n"
"        super().__init__(data_src)\n"
"\n"
"    @override\n"
"    def prepare_data(self, rc: Any) -> tuple[Dataset, Dataset, Any]:\n"
"        \"\"\"按照 RunConfig 规范切分并组装数据集。\n"
"\n"
"        Args:\n"
"            rc: RunConfig 强类型配置对象\n"
"\n"
"        Returns:\n"
"            (train_dataset, val_dataset, test_dataset)\n"
"        \"\"\"\n"
"        fold_idx = rc.data.fold\n"
"        logger.info(f\"Loading packed sequences for fold {fold_idx}...\")"
"\n"
"\n"
"        # 1. 统一加载对齐后的序列数据（零拷贝）\n"
"        sequences = self.load_sequences()\n"
"        partition = sequences.partition(fold_idx)\n"
"\n"
"        # 2. 提取核心张量\n"
"        questions = sequences.question\n"
"        responses = sequences.response\n"
"        masks = sequences.mask\n"
"        # 若需要提取主知识点：\n"
"        skills = to_first_skill_ids(sequences.skills)\n"
"\n"
"        # 3. 包装为 Dataset 并基于折划分应用切分\n"
"        full_dataset = MyKTDataset(questions, responses, masks, skills)\n"
"        train_dataset, val_dataset, _ = partition.apply(full_dataset)\n"
"\n"
"        # 4. 构建标准 Windowlate 窗口测试评估集（统一评估协议）\n"
"        test_dataset = self.create_windowlate_dataloader(\n"
"            batch_size=rc.model.batch_size,\n"
"            shuffle=False,\n"
"            num_workers=4,\n"
"            pin_memory=True,\n"
"        )\n"
"\n"
"        logger.info(\n"
"            f\"Data prepared: train={len(train_dataset)}, "
"val={len(val_dataset)}, \"\n"
"            f\"test(window)={len(test_dataset)}\"\n"
"        )\n"
"        return train_dataset, val_dataset, test_dataset\n"
msgstr ""
"\"\"\"MyKT model data loading and preparation.\"\"\"\n"
"\n"
"from typing import Any\n"
"\n"
"import torch\n"
"from torch.utils.data import Dataset\n"
"from typing_extensions import override\n"
"\n"
"from utils.core import get_logger\n"
"from utils.data_process import DataSource\n"
"from utils.model_data import QuestionModelData\n"
"from utils.model_data.packed_sequences import to_first_skill_ids\n"
"\n"
"logger = get_logger(__name__)\n"
"\n"
"\n"
"class MyKTDataset(Dataset):\n"
"    \"\"\"MyKT training and validation dataset.\"\"\"\n"
"\n"
"    def __init__(\n"
"        self,\n"
"        questions: torch.Tensor,\n"
"        responses: torch.Tensor,\n"
"        masks: torch.Tensor,\n"
"        skills: torch.Tensor | None = None,\n"
"    ):\n"
"        self.questions = questions\n"
"        self.responses = responses\n"
"        self.masks = masks\n"
"        self.skills = skills\n"
"\n"
"    def __len__(self) -> int:\n"
"        return len(self.questions)\n"
"\n"
"    def __getitem__(self, idx: int) -> tuple[torch.Tensor, ...]:\n"
"        q = torch.tensor(self.questions[idx], dtype=torch.long)\n"
"        r = torch.tensor(self.responses[idx], dtype=torch.long)\n"
"        m = torch.tensor(self.masks[idx], dtype=torch.bool)\n"
"        if self.skills is not None:\n"
"            s = torch.tensor(self.skills[idx], dtype=torch.long)\n"
"            return q, r, m, s\n"
"        return q, r, m\n"
"\n"
"\n"
"class MyKTModelData(QuestionModelData):\n"
"    \"\"\"MyKT data preparation processor.\"\"\"\n"
"\n"
"    def __init__(self, data_src: DataSource):\n"
"        super().__init__(data_src)\n"
"\n"
"    @override\n"
"    def prepare_data(self, rc: Any) -> tuple[Dataset, Dataset, Any]:\n"
"        \"\"\"Partition and assemble datasets according to RunConfig "
"specification.\n"
"\n"
"        Args:\n"
"            rc: RunConfig typed configuration object\n"
"\n"
"        Returns:\n"
"            (train_dataset, val_dataset, test_dataset)\n"
"        \"\"\"\n"
"        fold_idx = rc.data.fold\n"
"        logger.info(f\"Loading packed sequences for fold {fold_idx}...\")"
"\n"
"\n"
"        # 1. Load packed sequences (zero copy)\n"
"        sequences = self.load_sequences()\n"
"        partition = sequences.partition(fold_idx)\n"
"\n"
"        # 2. Extract core tensors\n"
"        questions = sequences.question\n"
"        responses = sequences.response\n"
"        masks = sequences.mask\n"
"        # Extract primary skill IDs if needed:\n"
"        skills = to_first_skill_ids(sequences.skills)\n"
"\n"
"        # 3. Wrap into Dataset and partition based on fold\n"
"        full_dataset = MyKTDataset(questions, responses, masks, skills)\n"
"        train_dataset, val_dataset, _ = partition.apply(full_dataset)\n"
"\n"
"        # 4. Construct standardized windowlate test evaluation loader\n"
"        test_dataset = self.create_windowlate_dataloader(\n"
"            batch_size=rc.model.batch_size,\n"
"            shuffle=False,\n"
"            num_workers=4,\n"
"            pin_memory=True,\n"
"        )\n"
"\n"
"        logger.info(\n"
"            f\"Data prepared: train={len(train_dataset)}, "
"val={len(val_dataset)}, \"\n"
"            f\"test(window)={len(test_dataset)}\"\n"
"        )\n"
"        return train_dataset, val_dataset, test_dataset\n"

