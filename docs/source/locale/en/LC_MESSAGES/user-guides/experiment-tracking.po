"early_stopping:\n"
"  monitor: auc\n"
"  mode: max\n"
"  patience: 10\n"
"experiment:\n"
"  model_name: GIKT\n"
"data:\n"
"  dataset: assistments09\n"
"  fold: 0\n"
"  kfold: 5\n"
"  max_seq_len: 200\n"
"model:\n"
"  epochs: 100\n"
"  batch_size: 128\n"
"  learning_rate: 0.001\n"
"  hidden_dim: 100\n"
msgstr ""
