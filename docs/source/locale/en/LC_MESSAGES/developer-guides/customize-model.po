#: ../../source/developer-guides/customize-model.md:292
#: c3b0d178f25f4a22b4875f86bdbe5453
msgid "在 `MyKT_trainer.py` 中的完整实现如下："
msgstr "The complete implementation in `MyKT_trainer.py` is as follows:"

#: ../../source/developer-guides/customize-model.md:294
#: cdfc620d2f784e8490072cd7dc275ab1
#, python-brace-format
msgid ""
"\"\"\"MyKT 训练器与模型配置。\"\"\"\n"
"\n"
"from dataclasses import field\n"
"\n"
"import torch\n"
"import torch.nn as nn\n"
"\n"
"from utils.config import ModelConfig\n"
"from utils.core import get_logger, register_model_config, "
"register_trainer\n"
"from utils.training import BaseTrainer, RuntimeComponents\n"
"\n"
"logger = get_logger(__name__)\n"
"\n"
"__all__ = [\"MyKTConfig\", \"MyKTTrainer\"]\n"
"\n"
"\n"
"@register_model_config(\"MyKT\")\n"
"class MyKTConfig(ModelConfig):\n"
"    \"\"\"MyKT 超参数配置树。\n"
"\n"
"    Args:\n"
"        embedding_dim: 题目与知识点的嵌入维度。\n"
"        hidden_dim: LSTM 隐状态特征维度。\n"
"        dropout: 失活概率。\n"
"        epochs: 训练轮数。\n"
"        batch_size: 批大小。\n"
"        learning_rate: 优化器初始学习率。\n"
"        weight_decay: L2 正则化系数。\n"
"    \"\"\"\n"
"\n"
"    embedding_dim: int = field(\n"
"        default=128,\n"
"        metadata={\"optuna\": {\"type\": \"categorical\", \"choices\": "
"[64, 128, 256]}},\n"
"    )\n"
"    hidden_dim: int = field(\n"
"        default=128,\n"
"        metadata={\"optuna\": {\"type\": \"categorical\", \"choices\": "
"[64, 128, 256]}},\n"
"    )\n"
"    dropout: float = field(\n"
"        default=0.2,\n"
"        metadata={\"optuna\": {\"type\": \"float\", \"low\": 0.0, "
"\"high\": 0.5}},\n"
"    )\n"
"    epochs: int = 150\n"
"    batch_size: int = field(\n"
"        default=128,\n"
"        metadata={\"optuna\": {\"type\": \"categorical\", \"choices\": "
"[64, 128, 256]}},\n"
"    )\n"
"    learning_rate: float = field(\n"
"        default=1e-3,\n"
"        metadata={\"optuna\": {\"type\": \"float\", \"low\": 1e-4, "
"\"high\": 1e-2, \"log\": True}},\n"
"    )\n"
"    weight_decay: float = 1e-5\n"
"\n"
"\n"
"@register_trainer(\"MyKT\")\n"
"class MyKTTrainer(BaseTrainer):\n"
"    \"\"\"MyKT 模型训练器。\"\"\"\n"
"\n"
"    def build_components(self, rc, data_src) -> RuntimeComponents:\n"
"        \"\"\"延迟装配模型、数据与优化器运行时实例。\"\"\"\n"
"        # 延迟局部导入，避免未使用的模型拖慢系统发现与 CLI 启动\n"
"        from model.MyKT.MyKT_data import MyKTModelData\n"
"        from model.MyKT.MyKT_model import MyKTNet\n"
"\n"
"        # 1. 准备数据\n"
"        train_data, val_data, test_data = "
"MyKTModelData(data_src).prepare_data(rc)\n"
"\n"
"        # 2. 从数据集获取元信息\n"
"        metadata = data_src.get_metadata()\n"
"        m = rc.model\n"
"\n"
"        # 3. 实例化模型并迁移到预定设备\n"
"        logger.info(f\"Initializing MyKT model with "
"dim={m.embedding_dim}...\")\n"
"        model = MyKTNet(\n"
"            num_questions=metadata[\"num_questions\"],\n"
"            num_skills=metadata[\"num_skills\"],\n"
"            embedding_dim=m.embedding_dim,\n"
"            hidden_dim=m.hidden_dim,\n"
"            dropout=m.dropout,\n"
"        )\n"
"\n"
"        # 4. 优化器与损失函数\n"
"        optimizer = torch.optim.Adam(\n"
"            model.parameters(),\n"
"            lr=m.learning_rate,\n"
"            weight_decay=m.weight_decay,\n"
"        )\n"
"        loss_fn = nn.BCELoss()\n"
"\n"
"        return RuntimeComponents(\n"
"            model=model,\n"
"            optimizer=optimizer,\n"
"            loss_fn=loss_fn,\n"
"            train_data=train_data,\n"
"            val_data=val_data,\n"
"            test_data=test_data,\n"
"            max_clip_grad_norm=5.0,  # 梯度裁剪阈值\n"
"        )\n"
"\n"
"    def forward_pass(self, batch_data: tuple) -> dict[str, torch.Tensor]:"
"\n"
"        \"\"\"执行单批次前向传播并严格对齐标签。\n"
"\n"
"        Args:\n"
"            batch_data: MyKTDataset 返回的数据元组 (q, r, m, [s])\n"
"\n"
"        Returns:\n"
"            标准化指标计算字典\n"
"        \"\"\"\n"
"        if len(batch_data) == 4:\n"
"            question, response, mask, skill = batch_data\n"
"            skill = self._move_tensor_to_device(skill)\n"
"        else:\n"
"            question, response, mask = batch_data\n"
"            skill = None\n"
"\n"
"        question = self._move_tensor_to_device(question)\n"
"        response = self._move_tensor_to_device(response)\n"
"        mask = self._move_tensor_to_device(mask)\n"
"\n"
"        # 1. 模型前向计算 [B, S]\n"
"        y_hat_full = self.model(question, response, mask, skill=skill)\n"
"\n"
"        # 2. 预测截断对齐（Next-item: same_position=False 默认，对齐 t 时刻预测与 t+1 标签）\n"
"        y_hat, y_label, _ = self._extract_valid_predictions(\n"
"            y_hat_full, response, mask, same_position=False\n"
"        )\n"
"\n"
"        # 3. 空批次防护\n"
"        y_hat, y_label = self._handle_empty_batch(y_hat, y_label)\n"
"\n"
"        # 4. 生成 0/1 离散预测\n"
"        y_predict = self._generate_binary_predictions(y_hat, "
"threshold=0.5)\n"
"\n"
"        return {\n"
"            \"y_hat\": y_hat,\n"
"            \"y_label\": y_label,\n"
"            \"y_predict\": y_predict,\n"
"            \"y_score\": y_hat,\n"
"            \"y_prob\": y_hat,\n"
"        }\n"
msgstr ""
"\"\"\"MyKT model configuration and trainer implementation.\"\"\"\n"
"\n"
"from dataclasses import field\n"
"import torch\n"
"import torch.nn as nn\n"
"from utils.config import ModelConfig\n"
"from utils.core import get_logger, register_model_config, "
"register_trainer\n"
"from utils.training import BaseTrainer, RuntimeComponents\n"
"\n"
"logger = get_logger(__name__)\n"
"\n"
"__all__ = [\"MyKTConfig\", \"MyKTTrainer\"]\n"
"\n"
"\n"
"@register_model_config(\"MyKT\")\n"
"class MyKTConfig(ModelConfig):\n"
"    \"\"\"MyKT hyperparameter configuration tree.\n"
"\n"
"    Args:\n"
"        embedding_dim: Embedding dimension for questions and skills.\n"
"        hidden_dim: LSTM hidden feature dimension.\n"
"        dropout: Dropout rate.\n"
"        epochs: Number of training epochs.\n"
"        batch_size: Batch size.\n"
"        learning_rate: Initial learning rate.\n"
"        weight_decay: L2 regularization coefficient.\n"
"    \"\"\"\n"
"\n"
"    embedding_dim: int = field(\n"
"        default=128,\n"
"        metadata={\"optuna\": {\"type\": \"categorical\", \"choices\": "
"[64, 128, 256]}},\n"
"    )\n"
"    hidden_dim: int = field(\n"
"        default=128,\n"
"        metadata={\"optuna\": {\"type\": \"categorical\", \"choices\": "
"[64, 128, 256]}},\n"
"    )\n"
"    dropout: float = field(\n"
"        default=0.2,\n"
"        metadata={\"optuna\": {\"type\": \"float\", \"low\": 0.0, "
"\"high\": 0.5}},\n"
"    )\n"
"    epochs: int = 150\n"
"    batch_size: int = field(\n"
"        default=128,\n"
"        metadata={\"optuna\": {\"type\": \"categorical\", \"choices\": "
"[64, 128, 256]}},\n"
"    )\n"
"    learning_rate: float = field(\n"
"        default=1e-3,\n"
"        metadata={\"optuna\": {\"type\": \"float\", \"low\": 1e-4, "
"\"high\": 1e-2, \"log\": True}},\n"
"    )\n"
"    weight_decay: float = 1e-5\n"
"\n"
"\n"
"@register_trainer(\"MyKT\")\n"
"class MyKTTrainer(BaseTrainer):\n"
"    \"\"\"MyKT model trainer.\"\"\"\n"
"\n"
"    def build_components(self, rc, data_src) -> RuntimeComponents:\n"
"        \"\"\"Lazily assemble runtime instances for model, data, and "
"optimizer.\"\"\"\n"
"        # Lazy local imports prevent unused models from slowing CLI "
"startup\n"
"        from model.MyKT.MyKT_data import MyKTModelData\n"
"        from model.MyKT.MyKT_model import MyKTNet\n"
"\n"
"        # 1. Prepare datasets\n"
"        train_data, val_data, test_data = "
"MyKTModelData(data_src).prepare_data(rc)\n"
"\n"
"        # 2. Retrieve metadata\n"
"        metadata = data_src.get_metadata()\n"
"        m = rc.model\n"
"\n"
"        # 3. Instantiate model\n"
"        logger.info(f\"Initializing MyKT model with "
"dim={m.embedding_dim}...\")\n"
"        model = MyKTNet(\n"
"            num_questions=metadata[\"num_questions\"],\n"
"            num_skills=metadata[\"num_skills\"],\n"
"            embedding_dim=m.embedding_dim,\n"
"            hidden_dim=m.hidden_dim,\n"
"            dropout=m.dropout,\n"
"        )\n"
"\n"
"        # 4. Optimizer and loss function\n"
"        optimizer = torch.optim.Adam(\n"
"            model.parameters(),\n"
"            lr=m.learning_rate,\n"
"            weight_decay=m.weight_decay,\n"
"        )\n"
"        loss_fn = nn.BCELoss()\n"
"\n"
"        return RuntimeComponents(\n"
"            model=model,\n"
"            optimizer=optimizer,\n"
"            loss_fn=loss_fn,\n"
"            train_data=train_data,\n"
"            val_data=val_data,\n"
"            test_data=test_data,\n"
"            max_clip_grad_norm=5.0,\n"
"        )\n"
"\n"
"    def forward_pass(self, batch_data: tuple) -> dict[str, torch.Tensor]:"
"\n"
"        \"\"\"Execute single-batch forward pass and align prediction "
"targets.\n"
"\n"
"        Args:\n"
"            batch_data: Data tuple from MyKTDataset (q, r, m, [s])\n"
"\n"
"        Returns:\n"
"            Standardized prediction metrics dictionary\n"
"        \"\"\"\n"
"        if len(batch_data) == 4:\n"
"            question, response, mask, skill = batch_data\n"
"            skill = self._move_tensor_to_device(skill)\n"
"        else:\n"
"            question, response, mask = batch_data\n"
"            skill = None\n"
"\n"
"        question = self._move_tensor_to_device(question)\n"
"        response = self._move_tensor_to_device(response)\n"
"        mask = self._move_tensor_to_device(mask)\n"
"\n"
"        # 1. Model forward computation [B, S]\n"
"        y_hat_full = self.model(question, response, mask, skill=skill)\n"
"\n"
"        # 2. Align predictions (Next-item: same_position=False aligns t "
"prediction with t+1 label)\n"
"        y_hat, y_label, _ = self._extract_valid_predictions(\n"
"            y_hat_full, response, mask, same_position=False\n"
"        )\n"
"\n"
"        # 3. Protect against empty batch\n"
"        y_hat, y_label = self._handle_empty_batch(y_hat, y_label)\n"
"\n"
"        # 4. Generate binary predictions\n"
"        y_predict = self._generate_binary_predictions(y_hat, "
"threshold=0.5)\n"
"\n"
"        return {\n"
"            \"y_hat\": y_hat,\n"
"            \"y_label\": y_label,\n"
"            \"y_predict\": y_predict,\n"
"            \"y_score\": y_hat,\n"
"            \"y_prob\": y_hat,\n"
"        }\n"

