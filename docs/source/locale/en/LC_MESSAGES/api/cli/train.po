msgstr "`--model.learning_rate`"

#: ../../source/api/cli/train.md e0c29d6d53914890a76fc43d2ba7fad6
msgid "`1e-3`"
msgstr "`1e-3`"

#: ../../source/api/cli/train.md a2eecc504a3145f58bcafa087fe23f58
msgid "初始学习率（默认 0.001）"
msgstr "Initial learning rate (default 0.001)"

#: ../../source/api/cli/train.md b7f76d86aae742fc8cfc745bc6476db5
msgid "`--model.weight_decay`"
msgstr "`--model.weight_decay`"

#: ../../source/api/cli/train.md 5e1cedf594234edda946f9f8148de52d
