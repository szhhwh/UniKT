msgstr ""
"data/assistments09/\n"
"├── raw/                                                    # Extracted "
"raw files\n"
"│   └── skill_builder_data_corrected_collapsed.csv\n"
"├── metadata.json                                           # Dataset "
"statistical metadata and fingerprint\n"
"├── assistments09_sequence.parquet                          # Cleaned "
"full student sequential interaction table\n"
"├── assistments09_split_question_sequence.parquet           # Standard "
"split sequences at question level\n"
"├── assistments09_split_skill_sequence.parquet              # Standard "
"split sequences at skill level\n"
"├── assistments09_relation_question_skill.parquet           # Question-"
