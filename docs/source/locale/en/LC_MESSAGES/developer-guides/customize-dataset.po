#: ../../source/developer-guides/customize-dataset.md:37
#: 53ee7f0f5c244b7bbc3f1eb529d9f76b
#, python-brace-format
msgid ""
"\"\"\"自定义数据集处理器模板。\"\"\"\n"
"\n"
"import os\n"
"from typing import Any\n"
"\n"
"import polars as pl\n"
"from typing_extensions import override\n"
"\n"
"from utils.core import get_logger, register_data_source\n"
"from utils.data_process.data_source import DataSource\n"
"\n"
"logger = get_logger(__name__)\n"
"\n"
"\n"
"@register_data_source(\"my_dataset\")\n"
"class MyDatasetData(DataSource):\n"
"    \"\"\"自定义知识追踪数据集处理器。\"\"\"\n"
"\n"
"    def __init__(self, args: Any) -> None:\n"
"        \"\"\"初始化数据集元信息与文件路径。\"\"\"\n"
"        super().__init__(\n"
"            dataset=\"my_dataset\",\n"
"            data_base_path=args.data.data_base_path,\n"
"            data_url=\"https://example.com/dataset/my_dataset.zip\",  # "
"下载源 URL（可选）\n"
"            seed=args.general.seed,\n"
"        )\n"
"        self.args = args\n"
"        # 原始数据文件存放于 data/<dataset>/raw/\n"
"        self.raw_data_path = os.path.join(self.data_folder, \"raw\", "
"\"interactions.csv\")\n"
"\n"
"    @override\n"
"    def load_src_data(self) -> None:\n"
"        \"\"\"从 raw 目录加载原始数据。推荐使用 Polars 提高加载性能。\"\"\"\n"
"        if not os.path.exists(self.raw_data_path):\n"
"            raise FileNotFoundError(f\"未找到原始数据文件: {self.raw_data_path}\")"
"\n"
"\n"
"        logger.info(f\"正在从 {self.raw_data_path} 加载原始数据...\")\n"
"        self.raw_data = pl.read_csv(\n"
"            self.raw_data_path,\n"
"            ignore_errors=True,\n"
"            null_values=[\"NA\", \"null\", \"\"],\n"
"        ).lazy()\n"
"\n"
"    @override\n"
"    def clean_raw_data(self) -> None:\n"
"        \"\"\"数据清洗与标准化字段重命名。\"\"\"\n"
"        if self.raw_data is None:\n"
"            self.load_src_data()\n"
"\n"
"        logger.info(\"执行原始数据清洗与字段对齐...\")\n"
"        data = self.raw_data.with_row_index(\"interaction_id\")\n"
"\n"
"        # 1. 重命名列为 UniKT 标准名称\n"
"        data = data.rename(\n"
"            {\n"
"                \"student_id\": \"user\",\n"
"                \"problem_id\": \"question\",\n"
"                \"kc_id\": \"skill\",\n"
"                \"is_correct\": \"label\",\n"
"                \"submit_time\": \"timestamp\",\n"
"            }\n"
"        )\n"
"\n"
"        # 2. 过滤缺失值与异常作答（如非 0/1 的作答结果）\n"
"        data = data.filter(\n"
"            pl.col(\"user\").is_not_null()\n"
"            & pl.col(\"question\").is_not_null()\n"
"            & pl.col(\"skill\").is_not_null()\n"
"            & pl.col(\"label\").is_in([0, 1])\n"
"        )\n"
"\n"
"        # 3. 按用户与时间戳全局排序\n"
"        data = data.sort([\"user\", \"timestamp\"])\n"
"\n"
"        self.cleaned_raw_data = data.collect()\n"
"        logger.info(f\"数据清洗完成，保留有效记录数: {len(self.cleaned_raw_data)}\")\n"
"\n"
"    @override\n"
"    def transform_data(self) -> None:\n"
"        \"\"\"执行紧凑 ID 映射、知识点列表组装并交付标准序列。\"\"\"\n"
"        logger.info(\"执行数据特征转换与 ID 重映射...\")\n"
"        if self.cleaned_raw_data is None:\n"
"            raise ValueError(\"必须先调用 clean_raw_data 后才能执行 "
"transform_data\")\n"
"\n"
"        # 1. 建立题目 ID 映射（将原始 ID 映射到 [0, N-1]）\n"
"        question_df = (\n"
"            self.cleaned_raw_data.select(\"question\")\n"
"            .unique()\n"
"            .sort(\"question\")\n"
"            .with_row_index(\"mapped_question\")\n"
"        )\n"
"        self._build_id_mapping(self.cleaned_raw_data, [\"question\"])\n"
"        mapped_data = self.cleaned_raw_data.join(\n"
"            question_df, on=\"question\"\n"
"        "
").with_columns(pl.col(\"mapped_question\").cast(pl.Int32).alias(\"question\"))"
"\n"
"\n"
"        # 2. 建立知识点映射并支持多知识点格式（例如 \"1_5_9\" 或单一 KC）\n"
"        # 提取全部唯一知识点并重编号\n"
"        unique_skills = "
"mapped_data.select(pl.col(\"skill\").cast(pl.Utf8)).unique()\n"
"        self._build_id_mapping(unique_skills, [\"skill\"])\n"
"\n"
"        # 3. 映射学生 ID 到 [0, U-1]\n"
"        self._build_id_mapping(mapped_data, [\"user\"])\n"
"        mapped_data = self._apply_id_mapping(mapped_data, [\"user\"])\n"
"\n"
"        # 4. 构建标准 List(Int32) 类型的 skills 列\n"
"        # 如果原始 skill 是字符串且包含分隔符，用 str.split 展开；否则直接转列表\n"
"        mapped_data = mapped_data.with_columns(\n"
"            "
"self._map_interaction_skills(pl.col(\"skill\").cast(pl.Utf8).str.split(\"_\"))"
"\n"
"        )\n"
"\n"
"        # 5. 组装规范序列数据\n"
"        sequence_data = mapped_data.select(\n"
"            [\n"
"                \"interaction_id\",\n"
"                \"skills\",\n"
"                \"user\",\n"
"                \"question\",\n"
"                \"label\",\n"
"                \"timestamp\",\n"
"            ]\n"
"        )\n"
"\n"
"        # 6. 保存题目-属性关系表（可选，供图神经网络或多任务模型使用）\n"
"        # self.relation_data = {\"q_matrix\": ...}\n"
"\n"
"        # 7. 提交处理后的交互表\n"
"        self.set_sequence_data(sequence_data)\n"
"        logger.info(\"数据转换与紧凑映射完成。\")\n"
msgstr ""
"\"\"\"Custom dataset processor template.\"\"\"\n"
"\n"
"import os\n"
"from typing import Any\n"
"\n"
"import polars as pl\n"
"from typing_extensions import override\n"
"\n"
"from utils.core import get_logger, register_data_source\n"
"from utils.data_process.data_source import DataSource\n"
"\n"
"logger = get_logger(__name__)\n"
"\n"
"\n"
"@register_data_source(\"my_dataset\")\n"
"class MyDatasetData(DataSource):\n"
"    \"\"\"Custom knowledge tracing dataset processor.\"\"\"\n"
"\n"
"    def __init__(self, args: Any) -> None:\n"
"        \"\"\"Initialize dataset metadata and file paths.\"\"\"\n"
"        super().__init__(\n"
"            dataset=\"my_dataset\",\n"
"            data_base_path=args.data.data_base_path,\n"
"            data_url=\"https://example.com/dataset/my_dataset.zip\",  # "
"Download URL (optional)\n"
"            seed=args.general.seed,\n"
"        )\n"
"        self.args = args\n"
"        # Raw data lives under data/<dataset>/raw/\n"
"        self.raw_data_path = os.path.join(self.data_folder, \"raw\", "
"\"interactions.csv\")\n"
"\n"
"    @override\n"
"    def load_src_data(self) -> None:\n"
"        \"\"\"Load raw data from the raw directory. Polars is recommended"
" for speed.\"\"\"\n"
"        if not os.path.exists(self.raw_data_path):\n"
"            raise FileNotFoundError(f\"Raw data file not found: "
"{self.raw_data_path}\")\n"
"\n"
"        logger.info(f\"Loading raw data from {self.raw_data_path}...\")\n"
"        self.raw_data = pl.read_csv(\n"
"            self.raw_data_path,\n"
"            ignore_errors=True,\n"
"            null_values=[\"NA\", \"null\", \"\"],\n"
"        ).lazy()\n"
"\n"
"    @override\n"
"    def clean_raw_data(self) -> None:\n"
"        \"\"\"Clean the data and standardize field names.\"\"\"\n"
"        if self.raw_data is None:\n"
"            self.load_src_data()\n"
"\n"
"        logger.info(\"Cleaning raw data and aligning fields...\")\n"
"        data = self.raw_data.with_row_index(\"interaction_id\")\n"
"\n"
"        # 1. Rename columns to UniKT's standard names\n"
"        data = data.rename(\n"
"            {\n"
"                \"student_id\": \"user\",\n"
"                \"problem_id\": \"question\",\n"
"                \"kc_id\": \"skill\",\n"
"                \"is_correct\": \"label\",\n"
"                \"submit_time\": \"timestamp\",\n"
"            }\n"
"        )\n"
"\n"
"        # 2. Drop missing values and invalid responses (labels other than"
" 0/1)\n"
"        data = data.filter(\n"
"            pl.col(\"user\").is_not_null()\n"
"            & pl.col(\"question\").is_not_null()\n"
"            & pl.col(\"skill\").is_not_null()\n"
"            & pl.col(\"label\").is_in([0, 1])\n"
"        )\n"
"\n"
"        # 3. Sort globally by user and timestamp\n"
"        data = data.sort([\"user\", \"timestamp\"])\n"
"\n"
"        self.cleaned_raw_data = data.collect()\n"
"        logger.info(f\"Cleaning complete; valid records kept: "
"{len(self.cleaned_raw_data)}\")\n"
"\n"
"    @override\n"
"    def transform_data(self) -> None:\n"
"        \"\"\"Build compact ID mappings, assemble skill lists, and emit "
"standard sequences.\"\"\"\n"
"        logger.info(\"Transforming features and remapping IDs...\")\n"
"        if self.cleaned_raw_data is None:\n"
"            raise ValueError(\"clean_raw_data must be called before "
"transform_data\")\n"
"\n"
"        # 1. Build the question ID mapping (original IDs -> [0, N-1])\n"
"        question_df = (\n"
"            self.cleaned_raw_data.select(\"question\")\n"
"            .unique()\n"
"            .sort(\"question\")\n"
"            .with_row_index(\"mapped_question\")\n"
"        )\n"
"        self._build_id_mapping(self.cleaned_raw_data, [\"question\"])\n"
"        mapped_data = self.cleaned_raw_data.join(\n"
"            question_df, on=\"question\"\n"
"        "
").with_columns(pl.col(\"mapped_question\").cast(pl.Int32).alias(\"question\"))"
"\n"
"\n"
"        # 2. Build the skill mapping; multi-skill formats (e.g. "
"\"1_5_9\") are supported\n"
"        # Collect every unique skill and renumber them\n"
"        unique_skills = "
"mapped_data.select(pl.col(\"skill\").cast(pl.Utf8)).unique()\n"
"        self._build_id_mapping(unique_skills, [\"skill\"])\n"
"\n"
"        # 3. Map student IDs to [0, U-1]\n"
"        self._build_id_mapping(mapped_data, [\"user\"])\n"
"        mapped_data = self._apply_id_mapping(mapped_data, [\"user\"])\n"
"\n"
"        # 4. Build the standard List(Int32) skills column\n"
"        # If raw skills are delimited strings, expand them with "
"str.split; otherwise wrap as a list\n"
"        mapped_data = mapped_data.with_columns(\n"
"            "
"self._map_interaction_skills(pl.col(\"skill\").cast(pl.Utf8).str.split(\"_\"))"
"\n"
"        )\n"
"\n"
"        # 5. Assemble standardized sequence data\n"
"        sequence_data = mapped_data.select(\n"
"            [\n"
"                \"interaction_id\",\n"
"                \"skills\",\n"
"                \"user\",\n"
"                \"question\",\n"
"                \"label\",\n"
"                \"timestamp\",\n"
"            ]\n"
"        )\n"
"\n"
"        # 6. Save the question-attribute relation table (optional; for "
"GNN or multi-task models)\n"
"        # self.relation_data = {\"q_matrix\": ...}\n"
"\n"
"        # 7. Submit the processed interaction table\n"
"        self.set_sequence_data(sequence_data)\n"
"        logger.info(\"Data transformation and compact mapping complete.\")"

