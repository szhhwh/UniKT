#: ../../source/developer-guides/customize-callback.md:1
#: 7a346b86b95a45f9b4a2ac3f1d469f0e
msgid "自定义回调与损失函数"
msgstr "Custom Callbacks and Loss Functions"

#: ../../source/developer-guides/customize-callback.md:3
#: 7a75d03d086a458bbeb78e4a37251c39
msgid "UniKT 提供了灵活且非侵入式的训练控制机制："
msgstr "UniKT provides flexible and non-intrusive training control mechanisms:"

#: ../../source/developer-guides/customize-callback.md:4
#: 5e8c1145405e48b892a1df5839ee3db0
msgid "**回调系统**：允许在训练生命周期的不同阶段注入自定义操作，例如 Epoch 起止、Phase 切换以及 Batch 迭代时的特征刷新或内存回收。"
msgstr ""
"**Callback System**: Allows injecting custom operations at different "
"stages of the training lifecycle, such as epoch start/end, phase "
"transitions, and batch iteration feature refreshes or memory cleanup."

#: ../../source/developer-guides/customize-callback.md:5
#: 65296162e10244d58e56b7ba1284ede4
msgid "**损失解耦机制**：支持在训练时引入辅助任务损失、对比学习损失或正则化项，同时严格确保验证集与测试集评估不受辅助损失干扰。"
msgstr ""
"**Loss Decoupling Mechanism**: Supports introducing auxiliary task "
"losses, contrastive learning losses, or regularization terms during "
"training, while strictly ensuring validation and test set evaluations "
"remain unaffected by auxiliary losses."

#: ../../source/developer-guides/customize-callback.md:9
#: 82f287480c1e4870a185e651785d4914
msgid "回调系统生命周期"
msgstr "Callback System Lifecycle"

#: ../../source/developer-guides/customize-callback.md:11
#: 9e9c2d82a607417d87fbfa1c5445f2e9
msgid ""
"UniKT 的 `Callback` 运行于 `BaseTrainer` 与 `MultiTrainer` "
"的训练主循环中。各钩子方法的触发时机由以下训练循环流程决定："
msgstr ""
"UniKT's `Callback` runs within the main training loop of `BaseTrainer` "
"and `MultiTrainer`. The trigger timing of hook methods is governed by the"
" following training loop workflow:"

#: ../../source/developer-guides/customize-callback.md:13
#: 8e83ccc9d2cd45d28129870c67d3f55b
msgid ""
"# 训练主循环与回调触发时机\n"
"def fit(epochs):\n"
"    cb.on_train_begin(epochs)\n"
"    try:\n"
"        for epoch in range(epochs):\n"
"            cb.on_epoch_begin(epoch)\n"
"            for phase in [\"train\", \"val\"]:\n"
"                cb.on_phase_begin(epoch, phase)\n"
"                for batch_idx, batch in enumerate(dataloader):\n"
"                    cb.on_batch_begin(epoch, batch_idx, phase)\n"
"                    loss, metrics = forward_and_backward(batch)\n"
"                    cb.on_batch_end(epoch, batch_idx, phase, loss)\n"
"                cb.on_phase_end(epoch, phase, phase_loss, metrics)\n"
"            cb.on_epoch_end(epoch, train_loss, val_loss)\n"
"            if cb.should_stop():\n"
"                break\n"
"        cb.on_train_end()\n"
"    finally:\n"
"        cb.close()\n"
msgstr ""
"# Main training loop and callback trigger points\n"
"def fit(epochs):\n"
"    cb.on_train_begin(epochs)\n"
"    try:\n"
"        for epoch in range(epochs):\n"
"            cb.on_epoch_begin(epoch)\n"
"            for phase in [\"train\", \"val\"]:\n"
"                cb.on_phase_begin(epoch, phase)\n"
"                for batch_idx, batch in enumerate(dataloader):\n"
"                    cb.on_batch_begin(epoch, batch_idx, phase)\n"
"                    loss, metrics = forward_and_backward(batch)\n"
"                    cb.on_batch_end(epoch, batch_idx, phase, loss)\n"
"                cb.on_phase_end(epoch, phase, phase_loss, metrics)\n"
"            cb.on_epoch_end(epoch, train_loss, val_loss)\n"
"            if cb.should_stop():\n"
"                break\n"
"        cb.on_train_end()\n"
"    finally:\n"
"        cb.close()\n"

#: ../../source/developer-guides/customize-callback.md:35
#: 65b5500c351d4e3fb42ebbb4acee8775
msgid "回调钩子接口全览"
msgstr "Overview of Callback Hook Interfaces"

#: ../../source/developer-guides/customize-callback.md:37
#: 0675c4dcbe244a82bb452fba4a755b15
msgid "所有自定义回调均继承自 `utils.training.Callback`，可按需重写以下方法："
msgstr ""
"All custom callbacks inherit from `utils.training.Callback` and can "
"override the following methods as needed:"

#: ../../source/developer-guides/customize-callback.md:39
#: ccf2d1e6babc411a963f2a84a808ee47
msgid ""
"from typing import Any\n"
"from utils.training import Callback\n"
"\n"
"\n"
"class MyCallback(Callback):\n"
"    def on_train_begin(self, epochs: int, **kwargs: Any) -> None:\n"
"        \"\"\"在整个训练开始前调用一次。\"\"\"\n"
"        pass\n"
"\n"
"    def on_train_end(self, **kwargs: Any) -> None:\n"
"        \"\"\"在训练正常完成时调用；若中途异常退出则不触发，使用 close 代替。\"\"\"\n"
"        pass\n"
"\n"
"    def on_epoch_begin(self, epoch: int, **kwargs: Any) -> None:\n"
"        \"\"\"在每个 epoch 迭代开始前调用。\"\"\"\n"
"        pass\n"
"\n"
"    def on_epoch_end(\n"
"        self, epoch: int, train_loss: float, val_loss: float | None, "
"**kwargs: Any\n"
"    ) -> None:\n"
"        \"\"\"在每个 epoch 结束且完成 train 和 val 后调用。\"\"\"\n"
"        pass\n"
"\n"
"    def on_phase_begin(self, epoch: int, phase: str, **kwargs: Any) -> "
"None:\n"
"        \"\"\"在进入 train 或 val 阶段时调用。\"\"\"\n"
"        pass\n"
"\n"
"    def on_phase_end(\n"
"        self,\n"
"        epoch: int,\n"
"        phase: str,\n"
"        loss: float,\n"
"        metrics: dict[str, float],\n"
"        **kwargs: Any,\n"
"    ) -> None:\n"
"        \"\"\"在完成某个 phase 的全部 batch 评估与指标累积后调用。\"\"\"\n"
"        pass\n"
"\n"
"    def on_batch_begin(\n"
"        self, epoch: int, batch_idx: int, phase: str, **kwargs: Any\n"
"    ) -> None:\n"
"        \"\"\"在批次前向传播开始前调用。\"\"\"\n"
"        pass\n"
"\n"
"    def on_batch_end(\n"
"        self,\n"
"        epoch: int,\n"
"        batch_idx: int,\n"
"        phase: str,\n"
"        loss: float,\n"
"        **kwargs: Any,\n"
"    ) -> None:\n"
"        \"\"\"在批次前向传播与反向传播完成后调用。\"\"\"\n"
"        pass\n"
"\n"
"    def should_stop(self, **kwargs: Any) -> bool:\n"
"        \"\"\"轮询是否需要提前终止训练，返回 True 则立即触发早停退出。\"\"\"\n"
"        return False\n"
"\n"
"    def close(self) -> None:\n"
"        \"\"\"在 Trainer 的 finally 保护块中调用，无论正常完成还是报错均会执行，用于释放资源。\"\"\"\n"
"        pass\n"
msgstr ""
"from typing import Any\n"
"from utils.training import Callback\n"
"\n"
"\n"
"class MyCallback(Callback):\n"
"    def on_train_begin(self, epochs: int, **kwargs: Any) -> None:\n"
"        \"\"\"Called once before training starts.\"\"\"\n"
"        pass\n"
"\n"
"    def on_train_end(self, **kwargs: Any) -> None:\n"
"        \"\"\"Called when training finishes normally; if an error occurs,"
" close is used instead.\"\"\"\n"
"        pass\n"
"\n"
"    def on_epoch_begin(self, epoch: int, **kwargs: Any) -> None:\n"
"        \"\"\"Called before each epoch iteration starts.\"\"\"\n"
"        pass\n"
"\n"
"    def on_epoch_end(\n"
"        self, epoch: int, train_loss: float, val_loss: float | None, "
"**kwargs: Any\n"
"    ) -> None:\n"
"        \"\"\"Called after each epoch finishes both train and val "
"phases.\"\"\"\n"
"        pass\n"
"\n"
"    def on_phase_begin(self, epoch: int, phase: str, **kwargs: Any) -> "
"None:\n"
"        \"\"\"Called when entering train or val phase.\"\"\"\n"
"        pass\n"
"\n"
"    def on_phase_end(\n"
"        self,\n"
"        epoch: int,\n"
"        phase: str,\n"
"        loss: float,\n"
"        metrics: dict[str, float],\n"
"        **kwargs: Any,\n"
"    ) -> None:\n"
"        \"\"\"Called after completing all batch evaluations and metric "
"accumulation for a phase.\"\"\"\n"
"        pass\n"
"\n"
"    def on_batch_begin(\n"
"        self, epoch: int, batch_idx: int, phase: str, **kwargs: Any\n"
"    ) -> None:\n"
"        \"\"\"Called before batch forward propagation starts.\"\"\"\n"
"        pass\n"
"\n"
"    def on_batch_end(\n"
"        self,\n"
"        epoch: int,\n"
"        batch_idx: int,\n"
"        phase: str,\n"
"        loss: float,\n"
"        **kwargs: Any,\n"
"    ) -> None:\n"
"        \"\"\"Called after batch forward and backward passes "
"finish.\"\"\"\n"
"        pass\n"
"\n"
"    def should_stop(self, **kwargs: Any) -> bool:\n"
"        \"\"\"Polled to check if training should terminate early; returns"
" True to trigger early stopping.\"\"\"\n"
"        return False\n"
"\n"
"    def close(self) -> None:\n"
"        \"\"\"Called in the trainer's finally block to release resources "
"on normal exit or exception.\"\"\"\n"
"        pass\n"

